    "Img02": "assets/images/personaggi/30/invz30_img_A_30",
    "Img03": "assets/images/personaggi/30/invz30_img_A_30",
    "Img04": "assets/images/personaggi/30/invz30_img_A_30",
    "Img05": "assets/images/personaggi/30/invz30_img_A_30",
