  {
    "ID": 49,
    "Personaggio/soggetto": "Luca",
    "Film/corto": "Luca",
    "Anno": 2021,
    "Regista/autore": "Enrico Casarosa",
    "Trama": "Disney and Pixar’s original feature film “Luca” is a coming-of-age story about one young boy experiencing an unforgettable summer filled with gelato, pasta and endless scooter rides. Luca shares these adventures with his newfound best friend, but all the fun is threatened by a deeply-held secret: they are sea monsters from another world just below the water’s surface.",
    "Link 1": "Trailer: https://www.youtube.com/watch?v=mYfJxlgR2jw",
    "Link 2": null,
    "Link 3": null,
    "Categoria Innovazione (tag) 1": "Motion",
    "Nome Innovazione 1": "Transformation Rig",
    "Paragrafo motivazione innovazione 1": "for the transformation from sea monster to human being",
    "Info specifiche sul funzionamento 1": "with the transformation rig animators could fine-tune the different aspects of the change one by one and see the result right there in front of them. That way, they could perfectly time the transition from the layers of changes in the human skin to the flipping scales and octopus spots in the sea-monster skin.\nThis was a new way to streamline the whole production process and put more artistic control in the hands of animators.",
    "Categoria Innovazione (tag) 2": null,
    "Nome Innovazione 2": null,
    "Paragrafo Funzionamento generale 2": null,
    "Funzionamento - info maggiori su tecnologie 2": null,
    "Copertina": "assets/images/personaggi/49/copertina_49",
    "Poster": "assets/images/personaggi/49/poster_49",
    "Img01": "assets/images/personaggi/49/invz49_img_A_49",
    "Img02": "assets/images/personaggi/49/invz49_img_A_49",
    "Img03": "assets/images/personaggi/49/invz49_img_A_49",
    "Img04": "assets/images/personaggi/49/invz49_img_A_49",
    "Img05": "assets/images/personaggi/49/invz49_img_A_49",
    "Img06": "assets/images/personaggi/49/invz49_img_A_49",
