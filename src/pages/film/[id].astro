---
import rawData from "../../data/pixar_archivio.json";

interface Film {
	ID: number;
	TITLE: string;
	CHARACTER: string | null;
	FILM_NAME: string | null;
	YEAR: number | null;
	SRC: string;
	optimizedSrc: string;
	posterSrc: string;
	optimizedPosterSrc: string;
	TECHNIQUE: string | null;
	DESCRIPTION: string | null;
	CATEGORY: string;
	SPECIFIC_INFO: string | null;
	TECHNIQUE2: string | null;
	DESCRIPTION2: string | null;
	CATEGORY2: string;
	SPECIFIC_INFO2: string | null;
	DIRECTOR: string | null;
	PLOT: string | null;
	LINK1: string | null;
	LINK2: string | null;
	LINK3: string | null;
	img01Src: string;
	img02Src: string;
	img03Src: string;
	img04Src: string;
	img05Src: string;
	img06Src: string;
}

export async function getStaticPaths() {
	const filmData = rawData.map((item, index) => {
		const raw: any = item;
		const name =
			raw["Film/corto"] || raw["Personaggio/soggetto"] || `Film ${index + 1}`;

		// Prefer Copertina for cover, otherwise look for first ImgXX
		let coverSrc = raw.Copertina || "";
		if (!coverSrc) {
			for (let i = 1; i <= 10; i++) {
				const key = `Img${String(i).padStart(2, "0")}`;
				if (raw[key]) {
					coverSrc = raw[key];
					break;
				}
			}
		}

		// Get Poster for film info section
		let posterSrc = raw.Poster || "";

		const extPattern = new RegExp("\\.(jpg|jpeg|png|webp|avif)$", "i");

		const coverFilename = coverSrc ? coverSrc.split("/").pop() || "" : "";
		const coverNameWithoutExt = coverFilename.replace(extPattern, "");

		const posterFilename = posterSrc ? posterSrc.split("/").pop() || "" : "";
		const posterNameWithoutExt = posterFilename.replace(extPattern, "");

		// Get innovation images (Img01, Img02, Img03)
		const img01 = raw.Img01 || "";
		const img02 = raw.Img02 || "";
		const img03 = raw.Img03 || "";
		const img04 = raw.Img04 || "";
		const img05 = raw.Img05 || "";
		const img06 = raw.Img06 || "";

		const img01Filename = img01 ? img01.split("/").pop() || "" : "";
		const img01NameWithoutExt = img01Filename.replace(extPattern, "");

		const img02Filename = img02 ? img02.split("/").pop() || "" : "";
		const img02NameWithoutExt = img02Filename.replace(extPattern, "");

		const img03Filename = img03 ? img03.split("/").pop() || "" : "";
		const img03NameWithoutExt = img03Filename.replace(extPattern, "");

		const img04Filename = img04 ? img04.split("/").pop() || "" : "";
		const img04NameWithoutExt = img04Filename.replace(extPattern, "");

		const img05Filename = img05 ? img05.split("/").pop() || "" : "";
		const img05NameWithoutExt = img05Filename.replace(extPattern, "");

		const img06Filename = img06 ? img06.split("/").pop() || "" : "";
		const img06NameWithoutExt = img06Filename.replace(extPattern, "");

		return {
			ID: raw.ID ?? index + 1,
			TITLE: name,
			CHARACTER: raw["Personaggio/soggetto"] || null,
			FILM_NAME: raw["Film/corto"] || null,
			YEAR: raw.Anno || null,
			SRC: coverSrc,
			optimizedSrc: coverNameWithoutExt
				? `/images/${coverNameWithoutExt}.webp`
				: "",
			posterSrc: posterSrc,
			optimizedPosterSrc: posterNameWithoutExt
				? `/images/${posterNameWithoutExt}.webp`
				: "",
			TECHNIQUE: raw["Nome Innovazione 1"] || null,
			DESCRIPTION: raw["Paragrafo motivazione innovazione 1"] || null,
			CATEGORY: raw["Categoria Innovazione (tag) 1"] || "",
			SPECIFIC_INFO: raw["Info specifiche sul funzionamento 1"] || null,
			TECHNIQUE2: raw["Nome Innovazione 2"] || null,
			DESCRIPTION2: raw["Paragrafo Funzionamento generale 2"] || null,
			CATEGORY2: raw["Categoria Innovazione (tag) 2"] || "",
			SPECIFIC_INFO2:
				raw["Funzionamento - info maggiori su tecnologie 2"] || null,
			DIRECTOR: raw["Regista/autore"] || null,
			PLOT: raw.Trama || null,
			LINK1: raw["Link 1"] || null,
			LINK2: raw["Link 2"] || null,
			LINK3: raw["Link 3"] || null,
			img01Src: img01NameWithoutExt
				? `/images/${img01NameWithoutExt}.webp`
				: "",
			img02Src: img02NameWithoutExt
				? `/images/${img02NameWithoutExt}.webp`
				: "",
			img03Src: img03NameWithoutExt
				? `/images/${img03NameWithoutExt}.webp`
				: "",
			img04Src: img04NameWithoutExt
				? `/images/${img04NameWithoutExt}.webp`
				: "",
			img05Src: img05NameWithoutExt
				? `/images/${img05NameWithoutExt}.webp`
				: "",
			img06Src: img06NameWithoutExt
				? `/images/${img06NameWithoutExt}.webp`
				: "",
		};
	});

	return filmData.map((film: Film) => ({
		params: { id: film.ID.toString() },
		props: { film },
	}));
}

interface Props {
	film: Film;
}

const { film } = Astro.props as Props;

// Funzione per convertire link YouTube in embed URL
function getYouTubeEmbedUrl(url: string | null): string | null {
	if (!url) return null;

	// Estrai l'ID del video da vari formati di URL YouTube
	const patterns = [
		/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\?\/]+)/,
		/youtube\.com\/embed\/([^&\?\/]+)/,
	];

	for (const pattern of patterns) {
		const match = url.match(pattern);
		if (match && match[1]) {
			return `https://www.youtube.com/embed/${match[1]}`;
		}
	}

	return null;
}

const embedUrl1 = getYouTubeEmbedUrl(film.LINK1);
const embedUrl2 = getYouTubeEmbedUrl(film.LINK2);
const embedUrl3 = getYouTubeEmbedUrl(film.LINK3);

import "../../styles/style.css";
import "../../styles/film-detail.css";
import FilmHeader from "../../components/FilmHeader.astro";
import Footer from "../../components/Footer.astro";
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{film.TITLE} - © Pixar 3D ARCHIVE</title>
	</head>
	<body>
		<div id="custom-cursor"></div>
		<FilmHeader />

		<!-- Cover Image -->
		<div class="cover-image">
			{
				film.optimizedSrc && (
					<img src={film.optimizedSrc} alt={film.TITLE} loading="eager" />
				)
			}
		</div>

		<div class="film-detail">
			<!-- DIV 1: Personaggio -->
			<div class="section-personaggio">
				<div class="innovation-tags">
					{
						film.TECHNIQUE && (
							<span class="innovation-tag">{film.TECHNIQUE}</span>
						)
					}
					{
						film.TECHNIQUE2 && (
							<span class="innovation-tag">{film.TECHNIQUE2}</span>
						)
					}
				</div>
				<h1>{film.CHARACTER || film.TITLE}</h1>
			</div>

			<!-- DIV 2: Film info e trama -->
			<div class="section-film-info">
				<div class="film-left">
					{
						film.FILM_NAME && (
							<>
								<span class="info-label">Film:</span>
								<span class="info-value">{film.FILM_NAME}</span>
							</>
						)
					}
					{
						film.DIRECTOR && (
							<>
								<span class="info-label">Director:</span>
								<span class="info-value">{film.DIRECTOR}</span>
							</>
						)
					}
					{
						film.YEAR && (
							<>
								<span class="info-label">Year:</span>
								<span class="info-value">{film.YEAR}</span>
							</>
						)
					}
				</div>
				<div class="film-image">
					{
						film.optimizedPosterSrc && (
							<img
								src={film.optimizedPosterSrc}
								alt={film.TITLE}
								loading="eager"
								width="400"
								height="300"
							/>
						)
					}
				</div>
				{
					film.PLOT && (
						<div class="plot">
							<p>{film.PLOT}</p>
						</div>
					)
				}
			</div>

			<!-- DIV 3: Innovazione -->
			<div class="section-innovazione">
				<div class="innovazione-left">
					<span class="info-label">Innovation:</span>
					{film.TECHNIQUE && <span class="info-value">{film.TECHNIQUE}</span>}
				</div>
				<div class="innovazione-right">
					{
						film.DESCRIPTION && (
							<div class="innovazione-description">
								<p>{film.DESCRIPTION}</p>
							</div>
						)
					}
					{
						film.SPECIFIC_INFO && (
							<div class="innovazione-description">
								<p>{film.SPECIFIC_INFO}</p>
							</div>
						)
					}
				</div>
				{
					film.TECHNIQUE2 && (
						<>
							<div class="innovation-divider" />
							<div class="innovazione-left">
								<span class="info-label">Innovation 2:</span>
								<span class="info-value">{film.TECHNIQUE2}</span>
							</div>
							<div class="innovazione-right">
								{film.DESCRIPTION2 && (
									<div class="innovazione-description">
										<p>{film.DESCRIPTION2}</p>
									</div>
								)}
								{film.SPECIFIC_INFO2 && (
									<div class="innovazione-description">
										<p>{film.SPECIFIC_INFO2}</p>
									</div>
								)}
							</div>
						</>
					)
				}
				<div class="innovazione-gallery">
					{
						film.img01Src && (
							<div class="gallery-img1">
								<img
									src={film.img01Src}
									alt="Innovation image 1"
									loading="lazy"
								/>
							</div>
						)
					}
					{
						film.img02Src && (
							<div class="gallery-img2">
								<img
									src={film.img02Src}
									alt="Innovation image 2"
									loading="lazy"
								/>
							</div>
						)
					}
					{
						film.img03Src && (
							<div class="gallery-img3">
								<img
									src={film.img03Src}
									alt="Innovation image 3"
									loading="lazy"
								/>
							</div>
						)
					}
					{
						film.img04Src && (
							<div class="gallery-img1">
								<img
									src={film.img04Src}
									alt="Innovation 2 image 1"
									loading="lazy"
								/>
							</div>
						)
					}
					{
						film.img05Src && (
							<div class="gallery-img2">
								<img
									src={film.img05Src}
									alt="Innovation 2 image 2"
									loading="lazy"
								/>
							</div>
						)
					}
					{
						film.img06Src && (
							<div class="gallery-img3">
								<img
									src={film.img06Src}
									alt="Innovation 2 image 3"
									loading="lazy"
								/>
							</div>
						)
					}
				</div>
			</div>

			<!-- DIV 5: Links (se presenti) -->
			{
				(embedUrl1 || embedUrl2 || embedUrl3) && (
					<div class="section-links">
						<div class="links-left">
							<span class="info-label">Media:</span>
						</div>
						<div class="links-content">
							{embedUrl1 && (
								<div class="embed-container">
									<iframe
										src={embedUrl1}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
							{embedUrl2 && (
								<div class="embed-container">
									<iframe
										src={embedUrl2}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
							{embedUrl3 && (
								<div class="embed-container">
									<iframe
										src={embedUrl3}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
						</div>
					</div>
				)
			}
		</div>
		<Footer />

		<script>
			// Import custom cursor logic
			import { initCustomCursor } from "../../scripts/customCursor.js";
			initCustomCursor();
		</script>
	</body>
</html>
