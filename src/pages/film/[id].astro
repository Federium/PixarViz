---
import rawData from "../../data/pixar_archivio.json";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../../styles/style.css";
import "../../styles/film-detail.css";
import FilmHeader from "../../components/FilmHeader.astro";
import Footer from "../../components/Footer.astro";

interface Film {
	ID: number;
	TITLE: string;
	CHARACTER: string | null;
	FILM_NAME: string | null;
	YEAR: number | null;
	coverSrc: string;
	posterSrc: string;
	img01Src: string;
	img02Src: string;
	img03Src: string;
	img04Src: string;
	img05Src: string;
	img06Src: string;
	TECHNIQUE: string | null;
	DESCRIPTION: string | null;
	CATEGORY: string;
	SPECIFIC_INFO: string | null;
	TECHNIQUE2: string | null;
	DESCRIPTION2: string | null;
	CATEGORY2: string;
	SPECIFIC_INFO2: string | null;
	DIRECTOR: string | null;
	PLOT: string | null;
	LINK1: string | null;
	LINK2: string | null;
	LINK3: string | null;
}

export async function getStaticPaths() {
	const filmData = rawData.map((item, index) => {
		const raw: any = item;
		const name =
			raw["Film/corto"] || raw["Personaggio/soggetto"] || `Film ${index + 1}`;

		// Prefer Copertina for cover
		let coverSrc = raw.Copertina || "";
		if (!coverSrc) {
			let imgIndex = 1;
			while (imgIndex <= 10) {
				const key = `Img${String(imgIndex).padStart(2, "0")}`;
				if (raw[key]) {
					coverSrc = raw[key];
					break;
				}
				imgIndex++;
			}
		}

		// Tutte le immagini mantengono il percorso originale da src/assets
		const posterSrc = raw.Poster || "";
		const img01Src = raw.Img01 || "";
		const img02Src = raw.Img02 || "";
		const img03Src = raw.Img03 || "";
		const img04Src = raw.Img04 || "";
		const img05Src = raw.Img05 || "";
		const img06Src = raw.Img06 || "";

		return {
			ID: raw.ID ?? index + 1,
			TITLE: name,
			CHARACTER: raw["Personaggio/soggetto"] || null,
			FILM_NAME: raw["Film/corto"] || null,
			YEAR: raw.Anno || null,
			coverSrc: coverSrc,
			posterSrc: posterSrc,
			img01Src: img01Src,
			img02Src: img02Src,
			img03Src: img03Src,
			img04Src: img04Src,
			img05Src: img05Src,
			img06Src: img06Src,
			TECHNIQUE: raw["Nome Innovazione 1"] || null,
			DESCRIPTION: raw["Paragrafo motivazione innovazione 1"] || null,
			CATEGORY: raw["Categoria Innovazione (tag) 1"] || "",
			SPECIFIC_INFO: raw["Info specifiche sul funzionamento 1"] || null,
			TECHNIQUE2: raw["Nome Innovazione 2"] || null,
			DESCRIPTION2: raw["Paragrafo Funzionamento generale 2"] || null,
			CATEGORY2: raw["Categoria Innovazione (tag) 2"] || "",
			SPECIFIC_INFO2:
				raw["Funzionamento - info maggiori su tecnologie 2"] || null,
			DIRECTOR: raw["Regista/autore"] || null,
			PLOT: raw.Trama || null,
			LINK1: raw["Link 1"] || null,
			LINK2: raw["Link 2"] || null,
			LINK3: raw["Link 3"] || null,
		};
	});

	return filmData.map((film: Film) => ({
		params: { id: film.ID.toString() },
		props: { film },
	}));
}

interface Props {
	film: Film;
}

const { film } = Astro.props as Props;

// Funzione helper per importare dinamicamente le immagini
const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);

async function getImageSrc(path: string) {
	if (!path) return null;
	// Rimuovi "assets/" se presente all'inizio del path
	const cleanPath = path.startsWith("assets/")
		? path.substring("assets/".length)
		: path;
	const fullPath = `/src/assets/${cleanPath}`;

	// Prova con diverse estensioni
	const extensions = [".jpg", ".jpeg", ".png", ".webp", ".avif"];
	let idx = 0;
	while (idx < extensions.length) {
		const ext = extensions[idx];
		const pathWithExt = fullPath.includes(".") ? fullPath : fullPath + ext;
		if (images[pathWithExt]) {
			return (await images[pathWithExt]()).default;
		}
		idx++;
	}
	return null;
}

// Importa le immagini
const coverImage = film.coverSrc ? await getImageSrc(film.coverSrc) : null;
const posterImage = film.posterSrc ? await getImageSrc(film.posterSrc) : null;
const img01Image = film.img01Src ? await getImageSrc(film.img01Src) : null;
const img02Image = film.img02Src ? await getImageSrc(film.img02Src) : null;
const img03Image = film.img03Src ? await getImageSrc(film.img03Src) : null;
const img04Image = film.img04Src ? await getImageSrc(film.img04Src) : null;
const img05Image = film.img05Src ? await getImageSrc(film.img05Src) : null;
const img06Image = film.img06Src ? await getImageSrc(film.img06Src) : null;

// Funzione per convertire link YouTube in embed URL
function getYouTubeEmbedUrl(url: string | null): string | null {
	if (!url) return null;

	// Estrai l'ID del video da vari formati di URL YouTube
	const patterns = [
		/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\?\/]+)/,
		/youtube\.com\/embed\/([^&\?\/]+)/,
	];

	let patternIdx = 0;
	while (patternIdx < patterns.length) {
		const pattern = patterns[patternIdx];
		const match = url.match(pattern);
		if (match && match[1]) {
			return `https://www.youtube.com/embed/${match[1]}`;
		}
		patternIdx++;
	}

	return null;
}

const embedUrl1 = getYouTubeEmbedUrl(film.LINK1);
const embedUrl2 = getYouTubeEmbedUrl(film.LINK2);
const embedUrl3 = getYouTubeEmbedUrl(film.LINK3);
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{film.TITLE} - © Pixar 3D ARCHIVE</title>
	</head>
	<body>
		<div id="custom-cursor"></div>
		<FilmHeader />

		<!-- Cover Image -->
		<div class="cover-image">
			{
				coverImage && (
					<Image
						src={coverImage}
						alt={film.TITLE}
						loading="eager"
						format="webp"
						quality={85}
					/>
				)
			}
		</div>

		<div class="film-detail">
			<!-- DIV 1: Personaggio -->
			<div class="section-personaggio">
				<div class="innovation-tags">
					{
						film.TECHNIQUE && (
							<span class="innovation-tag">{film.TECHNIQUE}</span>
						)
					}
					{
						film.TECHNIQUE2 && (
							<span class="innovation-tag">{film.TECHNIQUE2}</span>
						)
					}
				</div>
				<h1>{film.CHARACTER || film.TITLE}</h1>
			</div>

			<!-- DIV 2: Film info e trama -->
			<div class="section-film-info">
				<div class="film-left">
					{
						film.FILM_NAME && (
							<>
								<span class="info-label">Film:</span>
								<span class="info-value">{film.FILM_NAME}</span>
							</>
						)
					}
					{
						film.DIRECTOR && (
							<>
								<span class="info-label">Director:</span>
								<span class="info-value">{film.DIRECTOR}</span>
							</>
						)
					}
					{
						film.YEAR && (
							<>
								<span class="info-label">Year:</span>
								<span class="info-value">{film.YEAR}</span>
							</>
						)
					}
				</div>
				<div class="film-image">
					{
						posterImage && (
							<Image
								src={posterImage}
								alt={film.TITLE}
								loading="eager"
								width={400}
								height={300}
								format="webp"
							/>
						)
					}
				</div>
				{
					film.PLOT && (
						<div class="plot">
							<p>{film.PLOT}</p>
						</div>
					)
				}
			</div>

			<!-- DIV 3: Innovazione -->
			<div class="section-innovazione">
				<div class="innovazione-left">
					<span class="info-label">Innovation:</span>
					{film.TECHNIQUE && <span class="info-value">{film.TECHNIQUE}</span>}
				</div>
				<div class="innovazione-right">
					{
						film.DESCRIPTION && (
							<div class="innovazione-description">
								<p>{film.DESCRIPTION}</p>
							</div>
						)
					}
					{
						film.SPECIFIC_INFO && (
							<div class="innovazione-description">
								<p>{film.SPECIFIC_INFO}</p>
							</div>
						)
					}
				</div>
				{
					film.TECHNIQUE2 && (
						<>
							<div class="innovation-divider" />
							<div class="innovazione-left">
								<span class="info-label">Innovation 2:</span>
								<span class="info-value">{film.TECHNIQUE2}</span>
							</div>
							<div class="innovazione-right">
								{film.DESCRIPTION2 && (
									<div class="innovazione-description">
										<p>{film.DESCRIPTION2}</p>
									</div>
								)}
								{film.SPECIFIC_INFO2 && (
									<div class="innovazione-description">
										<p>{film.SPECIFIC_INFO2}</p>
									</div>
								)}
							</div>
						</>
					)
				}
				<div class="innovazione-gallery">
					{
						img01Image && (
							<div class="gallery-img1">
								<Image
									src={img01Image}
									alt="Innovation image 1"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
					{
						img02Image && (
							<div class="gallery-img2">
								<Image
									src={img02Image}
									alt="Innovation image 2"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
					{
						img03Image && (
							<div class="gallery-img3">
								<Image
									src={img03Image}
									alt="Innovation image 3"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
					{
						img04Image && (
							<div class="gallery-img1">
								<Image
									src={img04Image}
									alt="Innovation 2 image 1"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
					{
						img05Image && (
							<div class="gallery-img2">
								<Image
									src={img05Image}
									alt="Innovation 2 image 2"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
					{
						img06Image && (
							<div class="gallery-img3">
								<Image
									src={img06Image}
									alt="Innovation 2 image 3"
									loading="lazy"
									format="webp"
								/>
							</div>
						)
					}
				</div>
			</div>

			<!-- DIV 5: Links (se presenti) -->
			{
				(embedUrl1 || embedUrl2 || embedUrl3) && (
					<div class="section-links">
						<div class="links-left">
							<span class="info-label">Media:</span>
						</div>
						<div class="links-content">
							{embedUrl1 && (
								<div class="embed-container">
									<iframe
										src={embedUrl1}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
							{embedUrl2 && (
								<div class="embed-container">
									<iframe
										src={embedUrl2}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
							{embedUrl3 && (
								<div class="embed-container">
									<iframe
										src={embedUrl3}
										title="YouTube video player"
										frameborder="0"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
										allowfullscreen
									/>
								</div>
							)}
						</div>
					</div>
				)
			}
		</div>
		<Footer />

		<script>
			// Import custom cursor logic
			import { initCustomCursor } from "../../scripts/customCursor.js";
			initCustomCursor();
		</script>
	</body>
</html>
