          "content": {
            "size": 194980,
            "compression": 159010,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html><html lang=\"it\" data-astro-cid-j7pv25f6> <head><meta charset=\"utf-8\"><link rel=\"icon\" type=\"image/png\" href=\"/favicon.png\"><meta name=\"viewport\" content=\"width=device-width\"><meta name=\"generator\" content=\"Astro v5.15.3\"><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\"><title>© Pixar 3D ARCHIVE</title><style>@font-face{font-family:PP Mori;src:url(/_astro/PPMori-Extralight.BUMnfNi5.otf) format(\"opentype\");font-weight:200;font-style:normal}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-ExtralightItalic.scvXWP3B.otf) format(\"opentype\");font-weight:200;font-style:italic}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-Regular.DaF9uTp4.otf) format(\"opentype\");font-weight:400;font-style:normal}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-RegularItalic.DbzZRyLT.otf) format(\"opentype\");font-weight:400;font-style:italic}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-Semibold.BhqEhXdf.otf) format(\"opentype\");font-weight:600;font-style:normal}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-SemiboldItalic.BvHY0Dvr.otf) format(\"opentype\");font-weight:600;font-style:italic}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-Black.DjtomYsX.otf) format(\"opentype\");font-weight:900;font-style:normal}@font-face{font-family:PP Mori;src:url(/_astro/PPMori-BlackItalic.Db_j_UFn.otf) format(\"opentype\");font-weight:900;font-style:italic}:root{--font-family: \"PP Mori\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Helvetica Neue\", Arial, sans-serif;--font-size: .9rem;--font-size-small: .9rem;--font-size-medium: 2rem;--font-size-large: 4rem;--font-weight-semibold: 600;--font-weight-medium: 600;--font-weight-bold: 600;--font-weight-regular: 600;--line-height-tight: 1.2;--line-height-normal: 1.2;--line-height-relaxed: 1.2;--line-height-compact: 1;--color-text-primary: #000000;--color-text-secondary: #333333;--color-background: #ffffff;--color-border: #000000;--color-cursor: rgb(255, 255, 255);--font-size-mobile: .7rem;--font-size-mobile-header: 14pt}*{margin:0;padding:0;box-sizing:border-box}body{width:100vw;height:100vh;background:var(--color-background);font-family:var(--font-family)}#custom-cursor{position:fixed;width:10px;height:10px;border-radius:50%;background-color:var(--color-cursor);pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:difference}#custom-cursor.hover{width:20px;height:20px;transition:width .3s ease,height .3s ease}#canvas-container{position:fixed;inset:0;z-index:0;overflow:hidden;width:100%;height:100%}#canvas-container canvas{display:block;width:100vw;height:100vh}\n</style>\n<link rel=\"stylesheet\" href=\"/_astro/index.B0rsuGBW.css\">\n<style>#main-footer[data-astro-cid-sz7xmlte]{display:flex;flex-direction:column;gap:1rem;padding:2rem 0 4rem;border-top:1px solid var(--color-border);width:100%;margin:4rem 0}.footer-columns[data-astro-cid-sz7xmlte]{display:flex;justify-content:space-between;gap:2rem;padding:0 1rem}.footer-column[data-astro-cid-sz7xmlte]{display:flex;flex-direction:column;flex-shrink:0}.footer-column[data-astro-cid-sz7xmlte]:last-child{align-items:flex-end;text-align:right}.footer-text[data-astro-cid-sz7xmlte]{font-family:var(--font-family);font-size:var(--font-size);font-weight:var(--font-weight-semibold);color:var(--color-text-primary);margin:0}.footer-bottom[data-astro-cid-sz7xmlte]{width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:1rem 0;overflow:hidden}.marquee[data-astro-cid-sz7xmlte]{width:100%;overflow:hidden;position:relative}.marquee-content[data-astro-cid-sz7xmlte]{display:flex;gap:2rem;animation:marquee 20s linear infinite;width:max-content}@keyframes marquee{0%{transform:translate(0)}to{transform:translate(-50%)}}.footer-archive-svg[data-astro-cid-sz7xmlte]{width:25%;height:auto;display:block;flex-shrink:0}@media(max-width:768px){.footer-columns[data-astro-cid-sz7xmlte]{flex-wrap:wrap;gap:1.5rem;padding:0 1rem}.footer-text[data-astro-cid-sz7xmlte]{font-size:var(--font-size-mobile)}}\n</style></head> <body data-astro-cid-j7pv25f6> <div id=\"custom-cursor\" data-astro-cid-j7pv25f6></div> <header id=\"main-header\" data-astro-cid-3ef6ksr2> <div class=\"header-left\" data-astro-cid-3ef6ksr2> <a href=\"/about\" class=\"header-link\" data-astro-cid-3ef6ksr2>About</a> </div> <div class=\"header-center\" data-astro-cid-3ef6ksr2> <span class=\"header-title\" data-astro-cid-3ef6ksr2>© Pixar 3D ARCHIVE</span> </div> <div class=\"header-right\" data-astro-cid-3ef6ksr2> <button id=\"view-toggle\" class=\"view-switch\" data-astro-cid-3ef6ksr2> <span id=\"timeline-option\" class=\"switch-option\" data-astro-cid-3ef6ksr2> <span class=\"circle\" data-astro-cid-3ef6ksr2>●</span> Timeline\n</span> <span id=\"list-option\" class=\"switch-option\" data-astro-cid-3ef6ksr2> <span class=\"circle\" data-astro-cid-3ef6ksr2>○</span> List\n</span> </button> </div> </header>  <script type=\"module\">const o=document.getElementById(\"view-toggle\"),l=document.getElementById(\"timeline-option\"),c=document.getElementById(\"list-option\");let n=!1;o?.addEventListener(\"click\",()=>{n=!n;const e=l?.querySelector(\".circle\"),t=c?.querySelector(\".circle\");n?(e&&(e.textContent=\"○\"),t&&(t.textContent=\"●\")):(e&&(e.textContent=\"●\"),t&&(t.textContent=\"○\"));const i=new CustomEvent(\"viewToggle\",{detail:{isTableView:n}});window.dispatchEvent(i)});</script> <div id=\"gallery-view\" class=\"view active\" data-astro-cid-j7pv25f6> <div id=\"canvas-container\" data-gallery=\"[{&#34;ID&#34;:1,&#34;PERSONAGGIO&#34;:&#34;André&#34;,&#34;FILM&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;ANNO&#34;:1984,&#34;INNOVAZIONE&#34;:&#34;Teardrop shape (squash and stretch)&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/01/copertina_01&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_01.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:1,&#34;Personaggio/soggetto&#34;:&#34;André&#34;,&#34;Film/corto&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;Anno&#34;:1984,&#34;Regista/autore&#34;:&#34;Alvy Ray Smith&#34;,&#34;Trama&#34;:&#34;The short film opens with the protagonist, André, enjoying a peaceful nap in a bright, wooded clearing. His tranquillity is abruptly interrupted by the arrival of Wally B., a determined and lively bee.\\n\\nAndré immediately attempts to escape the bee's harassment, setting off a frantic chase in which the two characters move rapidly through the stylised landscape. The design and animation were revolutionary for the time, exploring motion blur techniques for the first time to make the movement more dynamic and faster.\\n\\nAfter a frantic chase, Wally B. almost catches up with André, but his attempt to sting him fails: the bee crashes into a tree trunk, deforming his stinger. As the confused bee flies away, André ends the brief confrontation by throwing his cap at Wally B., which hits him in mid-flight.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/a_9Tsbduk9E?si=4G6ra-9edkJfziRP&#34;,&#34;Link 2&#34;:&#34;https://youtu.be/LT3c0ZYvBCY?si=qJBETrRUCaqG9k1T&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Teardrop shape (squash and stretch)&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The modelling programme used at the time could only produce simple primitive geometric shapes (cones, cubes, spheres, cylinders, patches, lines, etc.), despite John Lasseter wanting a flexible pear shape for André's body and Wally B.'s feet, as found in most cartoon characters. Ed Catmull eventually managed to create a teardrop shape by using two spheres cut in half and made in different sizes, and the computer filled in the middle section, while Ed inserted controls to distort and bend them in different ways.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The characters, especially André, were distorted and exaggerated to express movement and emotion, just like in the fundamental principles of traditional Disney animation. This gave the 3D models a flexibility and vitality never seen before. For the first time, a polygonal model (André) could be animated through a digital “skeleton” or “virtual joint” system, enabling more natural and complex movements (such as running and bending).&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/01/copertina_01&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/01/poster_01&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/01/invz01_img_A_01&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/01/invz01_img_B_01&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/01/invz01_img_C_01&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:2,&#34;PERSONAGGIO&#34;:&#34;André and Wally B.&#34;,&#34;FILM&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;ANNO&#34;:1984,&#34;INNOVAZIONE&#34;:&#34;Motion Blur&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/02/copertina_02&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_02.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:2,&#34;Personaggio/soggetto&#34;:&#34;André and Wally B.&#34;,&#34;Film/corto&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;Anno&#34;:1984,&#34;Regista/autore&#34;:&#34;Alvy Ray Smith&#34;,&#34;Trama&#34;:&#34;The short film opens with the protagonist, André, enjoying a peaceful nap in a bright, wooded clearing. His tranquillity is abruptly interrupted by the arrival of Wally B., a determined and lively bee.\\n\\nAndré immediately attempts to escape the bee's harassment, setting off a frantic chase in which the two characters move rapidly through the stylised landscape. The design and animation were revolutionary for the time, exploring motion blur techniques for the first time to make the movement more dynamic and faster.\\n\\nAfter a frantic chase, Wally B. almost catches up with André, but his attempt to sting him fails: the bee crashes into a tree trunk, deforming his stinger. As the confused bee flies away, André ends the brief confrontation by throwing his cap at Wally B., which hits him in mid-flight.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/a_9Tsbduk9E?si=4G6ra-9edkJfziRP&#34;,&#34;Link 2&#34;:&#34;https://youtu.be/LT3c0ZYvBCY?si=qJBETrRUCaqG9k1T&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Motion Blur&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To make André's running and Wally B.'s flying look incredibly fast and dynamic, the team implemented computer-generated motion blur for the first time. This effect simulates what happens with a real high-speed camera: fast-moving objects appear blurred, tricking the eye and increasing the perception of speed on screen much more effectively than a simply shifted image.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/02/copertina_02&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/02/poster_02&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/02/invz01_img_A_02&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/02/invz02_img_B_02&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/02/invz02_img_C_02&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:3,&#34;PERSONAGGIO&#34;:&#34;Hill with trees&#34;,&#34;FILM&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;ANNO&#34;:1984,&#34;INNOVAZIONE&#34;:&#34;Particle systems&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Background&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/03/copertina_03&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_03.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:3,&#34;Personaggio/soggetto&#34;:&#34;Hill with trees&#34;,&#34;Film/corto&#34;:&#34;The adventures of André and Wally B.&#34;,&#34;Anno&#34;:1984,&#34;Regista/autore&#34;:&#34;Alvy Ray Smith&#34;,&#34;Trama&#34;:&#34;The short film opens with the protagonist, André, enjoying a peaceful nap in a bright, wooded clearing. His tranquillity is abruptly interrupted by the arrival of Wally B., a determined and lively bee.\\n\\nAndré immediately attempts to escape the bee's harassment, setting off a frantic chase in which the two characters move rapidly through the stylised landscape. The design and animation were revolutionary for the time, exploring motion blur techniques for the first time to make the movement more dynamic and faster.\\n\\nAfter a frantic chase, Wally B. almost catches up with André, but his attempt to sting him fails: the bee crashes into a tree trunk, deforming his stinger. As the confused bee flies away, André ends the brief confrontation by throwing his cap at Wally B., which hits him in mid-flight.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/a_9Tsbduk9E?si=4G6ra-9edkJfziRP&#34;,&#34;Link 2&#34;:&#34;https://youtu.be/LT3c0ZYvBCY?si=qJBETrRUCaqG9k1T&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Background&#34;,&#34;Nome Innovazione 1&#34;:&#34;Particle systems&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Bill Reeves had devised this system that was capable of creating and controlling millions of individual particles to build larger objects so that the short film could make it appear as if there were millions of leaves on the hill covered with trees.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/03/copertina_03&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/03/poster_03&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/03/invz03_img_A_03&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/03/invz03_img_B_03&#34;,&#34;Img03&#34;:null,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:4,&#34;PERSONAGGIO&#34;:&#34;Luxo Jr. and Luxo Sr.&#34;,&#34;FILM&#34;:&#34;Luxo Jr.&#34;,&#34;ANNO&#34;:1986,&#34;INNOVAZIONE&#34;:&#34;Self-shadowing&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Light&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/04/copertina_04&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_04.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:4,&#34;Personaggio/soggetto&#34;:&#34;Luxo Jr. and Luxo Sr.&#34;,&#34;Film/corto&#34;:&#34;Luxo Jr.&#34;,&#34;Anno&#34;:1986,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;In a dark room, a large table lamp named Luxo sees a small ball rolling towards him. He looks at it curiously and pushes it away, but the ball rolls back to him. He pushes it away again, but the ball rolls beside him as Luxo Junior, his lively son, jumps and plays with the ball. Luxo Junior then balances on the ball and squashes it, deflating it. He then flips the deflated ball onto its side and looks at Luxo, who gently admonishes his son. Luxo Junior then jumps off the screen in shame, but is later seen playing with a beach ball. Luxo looks at the camera, then shakes his head in embarrassment.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/6G3O60o5U7w?si=7oDmJj0wHMYZjUtN&#34;,&#34;Link 2&#34;:&#34;https://youtu.be/MJQRVKtwr70?si=M7lbt33BfbXz8I09&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Light&#34;,&#34;Nome Innovazione 1&#34;:&#34;Self-shadowing&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Self-shadowing is a rendering technique that allows a 3D object to cast shadows on itself. In ‘Luxo Jr.’, this was not just an aesthetic addition, but a crucial element in bringing the characters to life. It was made possible by the use of advanced ray tracing algorithms or shadow mapping techniques implemented by the Pixar team, allowing the shadows cast by the lampshade and the articulated joints of the lamp onto its base and arms to be seen, making Luxo Sr. and Luxo Jr. physically credible and giving them a perceived mass, transforming simple geometric models into tangible “characters”.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Luxo Jr. was a seminal short film for procedural animation. The surfaces in the short were not textured using bitmap images; colouring and light response were handled using surface shaders (programmed in the style that would later become standard with RenderMan). Colour, reflection and response to lighting were calculated procedurally at render time. John Lasseter animated the key poses and “character” behaviour of the lamps; Eben Ostby created procedural routines for repetitive tasks — for example, rolling the ball along its drawn trajectory and making it behave realistically. Luxo Jr. was an early practical example of “animator + computer”: the animator retains creative control over the keyframes, while the software automates the physical and repetitive details.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/04/copertina_04&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/04/poster_04&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/04/invz04_img_A_04&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/04/invz04_img_B_04&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/04/invz04_img_C_04&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:5,&#34;PERSONAGGIO&#34;:&#34;Juggling balls&#34;,&#34;FILM&#34;:&#34;Red's Dream&#34;,&#34;ANNO&#34;:1987,&#34;INNOVAZIONE&#34;:&#34;Quadratic programming algorithm&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/05/copertina_05&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_05.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:5,&#34;Personaggio/soggetto&#34;:&#34;Juggling balls&#34;,&#34;Film/corto&#34;:&#34;Red's Dream&#34;,&#34;Anno&#34;:1987,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;Red is a red unicycle abandoned in a dark and rainy corner of a bicycle shop. As the shop closes, Red dreams of performing in a circus show acclaimed by the audience. In his dream, a juggler enters the stage, but the props fall; Red picks them up and begins to juggle skilfully, taking the place of the star of the show. The dream ends abruptly with applause, and Red awakens alone in the darkness of the shop, realising that his life as a star is just an illusion.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/96xGUa1a_zs?si=Z-9dpkzHtmpj44Yk&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Quadratic programming algorithm&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The quadratic programming algorithm automatically calculated the trajectories of the balls. Since the PIC did not support Motion Blutr, the algorithm was also given the ability to calculate the “squash &#38; stretch”, that is, the deformation of the balls when they bounced, to make the movement more realistic. &#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;In those years, Pixar used the REYES (‘Render Everything You Ever Saw’) rendering architecture, whose key concept was that all complex geometries were divided into ‘micropolygons’, on which shading and visibility operations were then performed. This approach made it possible to handle very complex scenes with many objects, because it “normalised” the complexity of the geometry to a very fine level, making it a technique well suited to high-quality rendering. The director of the Red's Dream project, Ed Catmull, wanted the short film to be made using their hardware system, the Pixar Image Computer (PIC), and the ChapReyes rendering software (based on REYES). The Pixar Image Computer was a very advanced graphics system for its time, designed for parallel processing, with high memory bandwidth and bus speed. Although powerful, it had critical memory limitations for ChapReyes, so it was reduced to only a limited number of features. Due to these limitations, only the dream sequence was actually produced entirely with PIC. The bicycle shop scenes were extremely complex: a typical frame of those scenes contained over 10,000 geometric primitives, which in turn were composed of more than 30 million polygons. Nonostante il sistema PIC fosse potente, dopo la produzione di Red’s Dream, fu deciso di abbandonare questa tecnologia a causa delle sue limitazioni. The advantage of ChapReyes was that it could process between 50,000 and 100,000 complex polygons per minute, thereby significantly reducing the rendering time for frames that included textured surfaces, texture maps, multiple light sources, and shadows.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/05/copertina_05&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/05/poster_05&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/05/invz05_img_A_05&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/05/invz05_img_B_05&#34;,&#34;Img03&#34;:null,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:6,&#34;PERSONAGGIO&#34;:&#34;Toys&#34;,&#34;FILM&#34;:&#34;Tin Toy&#34;,&#34;ANNO&#34;:1988,&#34;INNOVAZIONE&#34;:&#34;Texture On Demand&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Texture&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/06/copertina_06&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_06.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:6,&#34;Personaggio/soggetto&#34;:&#34;Toys&#34;,&#34;Film/corto&#34;:&#34;Tin Toy&#34;,&#34;Anno&#34;:1988,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;A little tin soldier, Tinny, is thrilled to be the new toy of a child named Billy. However, Billy turns out to be a destructive child who throws and chews his toys. Frightened, Tinny hides under a sofa where he meets other terrified toys. When the child falls and starts crying, Tinny overcomes his fear and returns to comfort him, only to be ignored as soon as the child finds a music box that he prefers to play with. &#34;,&#34;Link 1&#34;:&#34;Short film:  https://youtu.be/DWi2WTqD59A?si=cA6LzgifuYVyndFN&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Texture&#34;,&#34;Nome Innovazione 1&#34;:&#34;Texture On Demand&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;TOD is a technique developed for managing large amounts of texture data on disk and loading it on demand during rendering. Textures are not stored as a linear image but divided into rectangular tiles of fixed size. During rendering, only the necessary tiles are read and stored in memory, thus allowing for lower memory consumption and a reduction in I/O (Input and Output), i.e. the flow of texture data between the various hardware and software components involved in the creation of computer-generated images. &#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The efficiency of TOD has made it possible to implement two new techniques: Texture Mapping and Bump Mapping. The first is the technique of “mapping” a two-dimensional image (texture) onto a 3D surface, where each point on the 3D surface has a coordinate (u, v) that indicates where to take the colour from the 2D texture. The second is a technique for simulating “roughness” or protrusions on the surface of an object without increasing the number of polygons.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/06/copertina_06&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/06/poster_06&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/06/invz06_img_A_06&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/06/invz06_img_B_06&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/06/invz06_img_C_06&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:7,&#34;PERSONAGGIO&#34;:&#34;Billy &#34;,&#34;FILM&#34;:&#34;Tin Toy&#34;,&#34;ANNO&#34;:1988,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/07/copertina_07&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_07.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:7,&#34;Personaggio/soggetto&#34;:&#34;Billy &#34;,&#34;Film/corto&#34;:&#34;Tin Toy&#34;,&#34;Anno&#34;:1988,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;A little tin soldier, Tinny, is thrilled to be the new toy of a child named Billy. However, Billy turns out to be a destructive child who throws and chews his toys. Frightened, Tinny hides under a sofa where he meets other terrified toys. When the child falls and starts crying, Tinny overcomes his fear and returns to comfort him, only to be ignored as soon as the child finds a music box that he prefers to play with. &#34;,&#34;Link 1&#34;:&#34;Short film:  https://youtu.be/DWi2WTqD59A?si=cA6LzgifuYVyndFN&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/07/copertina_07&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/07/poster_07&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/07/invz07_img_A_07&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/07/invz07_img_B_07&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/07/invz07_img_C_07&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:8,&#34;PERSONAGGIO&#34;:&#34;Knick &#34;,&#34;FILM&#34;:&#34;Knick Knack&#34;,&#34;ANNO&#34;:1989,&#34;INNOVAZIONE&#34;:&#34; 3D stereoscopy&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/08/copertina_08&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_08.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:8,&#34;Personaggio/soggetto&#34;:&#34;Knick &#34;,&#34;Film/corto&#34;:&#34;Knick Knack&#34;,&#34;Anno&#34;:1989,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;A snowman named Knick is trapped in his snow globe labelled “North Pole” on a shelf full of exotic souvenirs, including an attractive statuette of “Sunny Miami”. Desperate for company, Knick comically and violently attempts to escape his globe, trying to break it by any means necessary, without success. Finally, he takes advantage of the melting snow to knock the globe off the shelf. At last free, Knick lands in an aquarium below. As he swims towards a new, seductive mermaid, the glass dome of his old globe falls from the shelf, trapping him once again just inches from freedom.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/1BkcV_wYLC0?si=scGUDUzqgqTWPhQF&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34; 3D stereoscopy&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:&#34;To achieve stereoscopy, the team had to generate two views of the scene: one for the left eye and one for the right eye, with a slight difference in angle (interocular distance) to simulate depth perception. The technique required double calculation of the camera views and careful management of geometries/occlusions to avoid stereo artefacts.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/08/copertina_08&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/08/poster_08&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/08/invz08_img_A_08&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/08/invz08_img_B_08&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/08/invz08_img_C_08&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:9,&#34;PERSONAGGIO&#34;:&#34;Snow&#34;,&#34;FILM&#34;:&#34;Knick Knack&#34;,&#34;ANNO&#34;:1989,&#34;INNOVAZIONE&#34;:&#34;Blowers simulators&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Simulation/Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/09/copertina_09&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_09.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:9,&#34;Personaggio/soggetto&#34;:&#34;Snow&#34;,&#34;Film/corto&#34;:&#34;Knick Knack&#34;,&#34;Anno&#34;:1989,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;A snowman named Knick is trapped in his snow globe labelled “North Pole” on a shelf full of exotic souvenirs, including an attractive statuette of “Sunny Miami”. Desperate for company, Knick comically and violently attempts to escape his globe, trying to break it by any means necessary, without success. Finally, he takes advantage of the melting snow to knock the globe off the shelf. At last free, Knick lands in an aquarium below. As he swims towards a new, seductive mermaid, the glass dome of his old globe falls from the shelf, trapping him once again just inches from freedom.&#34;,&#34;Link 1&#34;:&#34;Short film: https://youtu.be/1BkcV_wYLC0?si=scGUDUzqgqTWPhQF&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Simulation/Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Blowers simulators&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The particle system already used for André and Wally B. was enhanced with a fluid simulator featuring blowers that pushed the snowflakes, causing them to float and move like a snowstorm. The process was parametric: the animators set the parameters and the system generated the snowflakes; then the result was retouched shot-by-shot until the desired effect was achieved.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/09/copertina_09&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/09/poster_09&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/09/invz09_img_A_09&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/09/invz09_img_B_09&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/09/invz09_img_C_09&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:10,&#34;PERSONAGGIO&#34;:&#34;Woody&#34;,&#34;FILM&#34;:&#34;Toy Story&#34;,&#34;ANNO&#34;:1995,&#34;INNOVAZIONE&#34;:&#34;Renderman&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling/Lights/Materials&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/10/copertina_10&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_10.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:10,&#34;Personaggio/soggetto&#34;:&#34;Woody&#34;,&#34;Film/corto&#34;:&#34;Toy Story&#34;,&#34;Anno&#34;:1995,&#34;Regista/autore&#34;:&#34;John Lassater&#34;,&#34;Trama&#34;:&#34;Have you ever wondered what toys do when people aren’t around? Toy Story answers this question with a fantastic and entertaining journey, seen mostly through the eyes of two rival toys: Woody, the tall and friendly cowboy, and Buzz Lightyear, the fearless Space Ranger. Guided by Woody, Andy’s toys live happily in his room—until Andy’s birthday brings Buzz Lightyear into the picture. Fearing he might lose his special place in Andy’s heart, Woody plots against Buzz. But when circumstances separate Buzz and Woody from their owner, the comically mismatched duo eventually learns to put their differences aside and finds itself on a hilarious, adventure-filled mission where the only way to survive is to form an unlikely alliance.&#34;,&#34;Link 1&#34;:&#34;Teaser: https://www.youtube.com/watch?v=QqIRLEg521Y&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=PX1p0lnhQ88&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling/Lights/Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;Renderman&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;RenderMan was crucial as the only system powerful enough to render the entire feature film. It made it possible to achieve the believable sheen of plastic on characters like Buzz Lightyear and the fabric textures on Woody, setting a new standard for cinematic CG animation.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Its key innovation lies in the REYES engine, a method that breaks down 3D surfaces into micropolygons and computes their appearance in an optimized way. This level of efficiency made it possible to produce entire CG feature films. In addition, the RenderMan Shading Language (RSL) gave artists unprecedented control, allowing them to program how light interacts with materials to achieve photorealistic effects such as plastic sheen and complex fabric detail. In this way, RenderMan established the industry standard for cinematic rendering.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/10/copertina_10&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/10/poster_10&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/10/invz10_img_A_10&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/10/invz10_img_B_10&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/10/invz10_img_C_10&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:11,&#34;PERSONAGGIO&#34;:&#34;Geri&#34;,&#34;FILM&#34;:&#34;Geri's Game&#34;,&#34;ANNO&#34;:1997,&#34;INNOVAZIONE&#34;:&#34;Subdivision Technique&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/11/copertina_11&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_11.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:11,&#34;Personaggio/soggetto&#34;:&#34;Geri&#34;,&#34;Film/corto&#34;:&#34;Geri's Game&#34;,&#34;Anno&#34;:1997,&#34;Regista/autore&#34;:&#34;Jan Pinkava&#34;,&#34;Trama&#34;:&#34;An elderly curmudgeon named Geri spends an entire day in the park playing a game of chess against himself. At a certain point, he begins to lose against his livelier opponent. But just when the match is about to end, Geri manages to turn the situation around.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=uMVtpCPx8ow&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=2UjfxAuXuSU&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=kC8jbGSiuIQ&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Subdivision Technique&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Subdivision Surface is a fundamental technique in 3D computer graphics that allows smooth, curved surfaces (organic shapes) to be generated from a simple polygonal control cage. Instead of manually modeling complex curves, the software performs an automatic calculation that transforms the base geometry into a finely detailed surface. This innovation was used in a revolutionary way in Pixar’s 1997 short Geri’s Game, where it made it possible to create the realistic modeling of the protagonist’s aged face and hands.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The technique is based on an iterative process (often relying on the Catmull–Clark algorithm): at each step, the low-resolution mesh is subdivided, creating new vertices and smaller polygons. These vertices are then repositioned and averaged according to precise mathematical rules that round off the angles and push the surface toward its ideal curved form. This method provides efficient scalability, allowing a high level of detail at render time while keeping the underlying base geometry easy to manipulate.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/11/copertina_11&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/11/poster_11&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/11/invz11_img_A_11&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/11/invz11_img_B_11&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/11/invz11_img_C_11&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:12,&#34;PERSONAGGIO&#34;:&#34;Heimlich&#34;,&#34;FILM&#34;:&#34;A Bug's Life&#34;,&#34;ANNO&#34;:1998,&#34;INNOVAZIONE&#34;:&#34;Subdivision Technique&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/12/copertina_12&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_12.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:12,&#34;Personaggio/soggetto&#34;:&#34;Heimlich&#34;,&#34;Film/corto&#34;:&#34;A Bug's Life&#34;,&#34;Anno&#34;:1998,&#34;Regista/autore&#34;:&#34;John Lasseter, Andrew Stanton&#34;,&#34;Trama&#34;:&#34;Flik is an independently minded ant—the only insect capable of throwing a wrench into the food chain. After one of his inventions goes terribly wrong, he sets out on a mission to save the colony from a band of lazy, menacing grasshoppers and win back the Queen’s favor. But when the group of “warrior bugs” Flik recruits turns out to be a clumsy circus troupe, he must believe in himself and his inventions to save Ant Island once and for all.&#34;,&#34;Link 1&#34;:&#34;Teaser: https://www.youtube.com/watch?v=CPen1YcWTgk&#34;,&#34;Link 2&#34;:&#34;Trailer: https://www.youtube.com/watch?v=JIOW6TjHrFI&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=KHfMUZ73ybg&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Subdivision Technique&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;From Geri’s Game (1997) to A Bug’s Life (1998), subdivision surfaces became an essential component of Pixar’s production pipeline, allowing the insect characters to gain a soft, continuous visual quality that would have been impossible to achieve with the traditional polygonal models of the time. In A Bug’s Life, subdivision surfaces were used to create rounded bodies with no visible edges, capable of deforming smoothly during animation. A key example is Heimlich, the circus caterpillar: his segmented shape, smooth skin, and exaggerated expressions required a technique able to preserve the softness of his silhouette even during extreme bends and comedic caricatures—something made possible precisely thanks to this technology.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Subdivision surfaces reiterate algorithms to transform a low-resolution mesh into a smooth, continuous surface while retaining the simplicity of the control model for animators. This allowed artists to manipulate Heimlich using a relatively simple structure—a series of main volumes for the head, thorax, and body segments—while the system automatically generated the higher level of detail at render time. The technique therefore ensured not only a more organic aesthetic but also more stable deformations in critical areas, such as the folds between the caterpillar’s segments, his plump cheeks, or highly flexible mouth, resulting in richer and more believable animation without an unmanageable computational load.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/12/copertina_12&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/12/poster_12&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/12/invz12_img_A_12&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/12/invz12_img_B_12&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/12/invz12_img_C_12&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:13,&#34;PERSONAGGIO&#34;:&#34;Buzz Lightyear&#34;,&#34;FILM&#34;:&#34;Toy Story 2&#34;,&#34;ANNO&#34;:1999,&#34;INNOVAZIONE&#34;:&#34;Shader function in Renderman&#34;,&#34;INNOVAZIONE2&#34;:&#34;Geppetto Software&#34;,&#34;CATEGORY&#34;:&#34;Materials/Texture&#34;,&#34;CATEGORY2&#34;:&#34;Modelling&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/13/copertina_13&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_13.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:13,&#34;Personaggio/soggetto&#34;:&#34;Buzz Lightyear&#34;,&#34;Film/corto&#34;:&#34;Toy Story 2&#34;,&#34;Anno&#34;:1999,&#34;Regista/autore&#34;:&#34;John Lasseter, Ash Brannon, Lee Unkrich&#34;,&#34;Trama&#34;:&#34;Buzz, Woody, and their friends return while Andy leaves for Cowboy Camp, leaving his toys to fend for themselves. The situation changes dramatically when an obsessive toy collector named Al McWhiggin, owner of Al’s Toy Barn, kidnaps Woody. In Al’s apartment, Woody discovers that he is a highly valuable collectible from a 1950s TV show called Woody’s Roundup. There he also meets the other precious toys from the series: Jessie the cowgirl, Bullseye the horse, and Stinky Pete the prospector. Andy’s toys organize a daring rescue mission, Buzz Lightyear meets someone who can challenge him, and Woody must decide where his true place—and his heart—really lies.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=09qc_4mzGqw&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=AkiEyseaM1k&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Materials/Texture&#34;,&#34;Nome Innovazione 1&#34;:&#34;Shader function in Renderman&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;In Toy Story 2, Pixar integrated the Shader function in RenderMan for the first time to define the final appearance of materials, creating believable surfaces and, in particular, more realistic human skin by adding a layer of detail on top of the base form—pores, sweat, moles, freckles, and other imperfections.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Technically, shaders calculate how light interacts with each surface during rendering, combining procedural textures, displacement maps, and lighting models to create detailed and believable materials without overcomplicating the underlying geometry.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 2&#34;:&#34;Geppetto Software&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;The in-house Geppetto system was used for rigging and character control, enabling more complex and intuitive animations for Jessie, Stinky Pete, Bullseye, and Buzz Lightyear.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;Geppetto allows the definition of hierarchies of bones, constraints, deformers, and high-level controls: the animator manipulates simple controls while the software automatically calculates the mesh deformations (skin deformations), simplifying facial animations, elastic movements, and complex bending.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Shader function in Renderman/Geppetto Software&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/13/copertina_13&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/13/poster_13&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/13/invz13_img_A_13&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/13/invz13_img_B_13&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/13/invz13_img_C_13&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:14,&#34;PERSONAGGIO&#34;:&#34;Birds&#34;,&#34;FILM&#34;:&#34;For The Birds&#34;,&#34;ANNO&#34;:2000,&#34;INNOVAZIONE&#34;:&#34;Contact Pads&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/14/copertina_14&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_14.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:14,&#34;Personaggio/soggetto&#34;:&#34;Birds&#34;,&#34;Film/corto&#34;:&#34;For The Birds&#34;,&#34;Anno&#34;:2000,&#34;Regista/autore&#34;:&#34;Ralph Eggleston&#34;,&#34;Trama&#34;:&#34;One by one, a flock of small birds lands on a telephone wire. Being so close together already causes some problems, but then a large, clumsy bird tries to join them. The similar-looking birds can’t help but tease him—and in the end, their flock mentality proves to be embarrassing.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=DeEZx4K0Eic&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Contact Pads&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Pixar wanted the small birds to squish against each other when there wasn’t enough space on the telephone wire, but without their meshes interpenetrating unnaturally. The “contact pads” were used precisely to simulate physical contact: they create the illusion that the birds are touching and compressing, while maintaining precise control over deformations, thus providing a believable sense of pressure and volume during the animation.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Bill Wise, the technical supervisor, created “widgets” in the form of flexible disks—the contact pads—that were placed between the birds. These pads were linked to the birds, and animators could directly shape and animate them. The code checked whether certain points on a bird’s mesh were inside the pad’s bounding box: when a point was inside, it was displaced to deform the bird’s surface according to the pad’s shape. This system allowed two nearby birds to compress against the same pad and deform accordingly, maintaining a realistic interaction.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/14/copertina_14&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/14/poster_14&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/14/invz14_img_A_14&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/14/invz14_img_B_14&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/14/invz14_img_C_14&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:15,&#34;PERSONAGGIO&#34;:&#34;Sully and Boo&#34;,&#34;FILM&#34;:&#34;Monsters, Inc.&#34;,&#34;ANNO&#34;:2001,&#34;INNOVAZIONE&#34;:&#34;Simulation&#34;,&#34;INNOVAZIONE2&#34;:&#34;Fizt&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Motion&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/15/copertina_15&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_15.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:15,&#34;Personaggio/soggetto&#34;:&#34;Sully and Boo&#34;,&#34;Film/corto&#34;:&#34;Monsters, Inc.&#34;,&#34;Anno&#34;:2001,&#34;Regista/autore&#34;:&#34;Pete Docter, Lee Unkrich, David Silverman&#34;,&#34;Trama&#34;:&#34;There’s a reason why monsters live in children’s closets: it’s their job. Monsters, Inc. is the most efficient scream-processing factory in the monster world, and there’s no better Scarer than James P. Sullivan. But when “Sulley” accidentally lets a little human girl into Monstropolis, his life—and that of his friend Mike—gets turned upside down.&#34;,&#34;Link 1&#34;:&#34;Teaser: https://www.youtube.com/watch?v=86kC3rMFFq4&#34;,&#34;Link 2&#34;:&#34;Trailer: https://www.youtube.com/watch?v=LF6X4W_OQr8&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=XzLp5GQ9AnE&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Simulation&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Simulation was applied to Sulley’s fur, allowing his more than 2.3 million hairs to respond realistically to body movements and interactions with the environment, ensuring a natural appearance during jumps, runs, or contact with other characters.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Simulation is based on hair and fiber dynamics algorithms that calculate the forces and interactions acting on each strand, as well as gravity and inertia, allowing them to respond automatically to the character’s movements and surrounding objects. This system produces realistic deformations without the need to animate each individual strand manually, ensuring visual consistency while saving animators significant time.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 2&#34;:&#34;Fizt&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;Fizt has been crucial for animating Boo’s T-shirt and other clothing: before Monsters Inc., clothing in Pixar films followed the body rigidly without its own dynamics, whereas Fizt allowed garments to be treated as separate entities, simulating folds, swings, and interactions with the characters’ movements in a believable way.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;It works like a cloth simulator: each garment or separate element is treated as a physical object with mass, friction, and constraints. The software calculates how the clothing responds to body movements, collisions with other objects, and gravity, allowing Boo and her T-shirt to move independently of the underlying body model.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Simulation/Fizt&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/15/copertina_15&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/15/poster_15&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/15/invz15_img_A_15&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/15/invz15_img_B_15&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/15/invz15_img_C_15&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:16,&#34;PERSONAGGIO&#34;:&#34;Mike Wasowski&#34;,&#34;FILM&#34;:&#34;Mike's New Car&#34;,&#34;ANNO&#34;:2001,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/16/copertina_16&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_16.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:16,&#34;Personaggio/soggetto&#34;:&#34;Mike Wasowski&#34;,&#34;Film/corto&#34;:&#34;Mike's New Car&#34;,&#34;Anno&#34;:2001,&#34;Regista/autore&#34;:&#34;Pete Docter, Roger Gould&#34;,&#34;Trama&#34;:&#34;Mike discovers that being the top laugh collector at Monsters, Inc. has its perks—like earning enough money to buy a six-wheeled, gadget-packed car. However, the new-car scent doesn’t last long, as Sulley sets off an ill-fated test drive that teaches Mike the true meaning of buyer’s remorse.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=zfC_GuHiP68&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/16/copertina_16&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/16/poster_16&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/16/invz16_img_A_16&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/16/invz16_img_B_16&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/16/invz16_img_C_16&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:17,&#34;PERSONAGGIO&#34;:&#34;Jellyfishes&#34;,&#34;FILM&#34;:&#34;Finding Nemo&#34;,&#34;ANNO&#34;:2003,&#34;INNOVAZIONE&#34;:&#34;Transblurrency&#34;,&#34;INNOVAZIONE2&#34;:&#34;Subsurface Scattering&#34;,&#34;CATEGORY&#34;:&#34;Light&#34;,&#34;CATEGORY2&#34;:&#34;Light&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/17/copertina_17&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_17.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:17,&#34;Personaggio/soggetto&#34;:&#34;Jellyfishes&#34;,&#34;Film/corto&#34;:&#34;Finding Nemo&#34;,&#34;Anno&#34;:2003,&#34;Regista/autore&#34;:&#34;Andrew Stanton&#34;,&#34;Trama&#34;:&#34;In the colorful, warm tropical waters of the Great Barrier Reef, a clownfish named Marlin lives safely and secluded in his anemone with his only son, Nemo. Fearful of the ocean and its unpredictable dangers, Marlin struggles to protect his child. Nemo, like all young fish, is eager to explore the mysterious reef. When Nemo is suddenly taken far from home and placed in a kitschy aquarium in a dentist’s office, Marlin unwillingly becomes the hero of an epic adventure to rescue his son.&#34;,&#34;Link 1&#34;:&#34;Teaser: https://www.youtube.com/watch?v=GraVZbADTRY&#34;,&#34;Link 2&#34;:&#34;Trailer: https://www.youtube.com/watch?v=VtZ6C3M0q28&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=Ir9HKm5nbW4&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Light&#34;,&#34;Nome Innovazione 1&#34;:&#34;Transblurrency&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;This innovation was useful to achieve a realistic appearance for underwater environments and characters. Transblurrency was used to simulate light filtering through water and semi-transparent objects such as jellyfish, making the lighting and color more realistic in relation to depth and camera distance.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Translucency calculates how light passes through semi-transparent objects, blending the background based on distance and depth and adjusting light intensity according to the rays’ path and the camera’s position.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Light&#34;,&#34;Nome Innovazione 2&#34;:&#34;Subsurface Scattering&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;Subsurface Scattering was used to reproduce the way light diffuses within organic materials, such as fish skin and coral scales, giving the characters a soft, luminous, and three-dimensional appearance.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;It is able to simulate the behavior of light within organic materials: light penetrates, diffuses internally, and emerges at a different point, creating an effect of softness and translucency that makes the characters’ bodies appear more realistic. The integration of these techniques allowed Pixar to achieve environments and characters with an unprecedented level of visual realism, convincingly rendering the interaction of light with water and organic materials.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Transblurrency/Subsurface Scattering&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/17/copertina_17&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/17/poster_17&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/17/invz17_img_A_17&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/17/invz17_img_B_17&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/17/invz17_img_C_17&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:18,&#34;PERSONAGGIO&#34;:&#34;Animals&#34;,&#34;FILM&#34;:&#34;Boundin'&#34;,&#34;ANNO&#34;:2003,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/18/copertina_18&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_18.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:18,&#34;Personaggio/soggetto&#34;:&#34;Animals&#34;,&#34;Film/corto&#34;:&#34;Boundin'&#34;,&#34;Anno&#34;:2003,&#34;Regista/autore&#34;:&#34;Bud Luckey&#34;,&#34;Trama&#34;:&#34;On a highland lives a lamb with a coat so splendid that it can’t help but prance. But one day, it loses its shiny fleece—and along with it, its pride. It takes a wise jackalope—a horned rabbit—to teach the dejected lamb that, with or without its wool, what truly matters is what’s inside, giving it the strength to overcome life’s challenges.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=VkUi4qdZStQ&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/18/copertina_18&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/18/poster_18&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/18/invz18_img_A_18&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/18/invz18_img_B_18&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/18/invz18_img_C_18&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:19,&#34;PERSONAGGIO&#34;:&#34;Mr. Incredible&#34;,&#34;FILM&#34;:&#34;The Incredibles&#34;,&#34;ANNO&#34;:2004,&#34;INNOVAZIONE&#34;:&#34;Goo Muscle Rig &#34;,&#34;INNOVAZIONE2&#34;:&#34;Core Simulation Engine&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Motion&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/19/copertina_19&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_19.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:19,&#34;Personaggio/soggetto&#34;:&#34;Mr. Incredible&#34;,&#34;Film/corto&#34;:&#34;The Incredibles&#34;,&#34;Anno&#34;:2004,&#34;Regista/autore&#34;:&#34;Brad Bird&#34;,&#34;Trama&#34;:&#34;It takes a steel will to hide your superhero talents from a world that still needs you but no longer appreciates what you’re capable of. Struggling with a prominent belly and a boring job, Mr. Incredible longs for the glorious days of upholding law and order, while his superhuman family tries to adapt to a “normal” life. Relief from the quiet suburban routine finally comes years later, when the family uncovers an evil plot and must join forces to save the day.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=Mld9JmwtgsM&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=GskPj5i0vps&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Goo Muscle Rig &#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To achieve realistic deformations of muscles and the body during dynamic actions such as jumps, punches, and acrobatic movements, the Goo Muscle Rig was introduced. It allowed animators to credibly animate muscle contraction and expansion, adapting the characters’ skin to their movements and providing real-time visual feedback as animators manipulated the limbs.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The Goo Muscle Rig is an advanced rigging system that allows characters’ skin to adapt to movement by simulating the compression and stretching of the underlying muscles. This includes handling tricky areas like the shoulders, where the trapezius and pectoral muscles interact to produce natural deformations consistent with the pose. Animators can manipulate the poses directly, while the rig calculates realistic muscle and skin deformations in real time.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 2&#34;:&#34;Core Simulation Engine&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;The Core Simulation handles complex collisions of long hair while keeping it flowing and dynamic during action, enhancing the realism of the animations.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;The Core Simulation Engine, on the other hand, functions as an internal physics engine that manages all collisions and interactions of long hair, keeping it fluid and realistic during movement. For Mr. Incredible, this system allowed the emphasis of his muscle power and mass without losing naturalness; for Violet, it ensured believable hair and slender body animations during action scenes and invisibility sequences.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Goo Muscle Rig/Core Simulation Engine&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/19/copertina_19&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/19/poster_19&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/19/invz19_img_A_19&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/19/invz19_img_B_19&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/19/invz19_img_C_19&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:20,&#34;PERSONAGGIO&#34;:&#34;Musicians&#34;,&#34;FILM&#34;:&#34;One Man Band&#34;,&#34;ANNO&#34;:2005,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/20/copertina_20&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_20.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:20,&#34;Personaggio/soggetto&#34;:&#34;Musicians&#34;,&#34;Film/corto&#34;:&#34;One Man Band&#34;,&#34;Anno&#34;:2005,&#34;Regista/autore&#34;:&#34;Andrew Jimenez&#34;,&#34;Trama&#34;:&#34;With a single coin to toss into the town square fountain to make a wish, a peasant girl encounters two competing street performers, who would rather the coin land in their tip hats. Little Tippy finds herself caught in the middle as a musical duel between the solo bands begins.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=01GY7zYN-ps&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/20/copertina_20&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/20/poster_20&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/20/invz20_img_A_20&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/20/invz20_img_B_20&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/20/invz20_img_C_20&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:21,&#34;PERSONAGGIO&#34;:&#34;Jack-Jack&#34;,&#34;FILM&#34;:&#34;Jack-Jack Attack&#34;,&#34;ANNO&#34;:2005,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/21/copertina_21&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_21.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:21,&#34;Personaggio/soggetto&#34;:&#34;Jack-Jack&#34;,&#34;Film/corto&#34;:&#34;Jack-Jack Attack&#34;,&#34;Anno&#34;:2005,&#34;Regista/autore&#34;:&#34;Brad Bird&#34;,&#34;Trama&#34;:&#34;Kari, the babysitter, expects to spend a routine evening caring for the children. She’s prepared to provide neurological stimulation along with some relaxing music for little Jack-Jack, the youngest member of the extraordinary Parr family. What she doesn’t yet know is that Jack-Jack is about to teach her something about children with “special needs.”&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=Ze6snJiWLRI&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;In Jack-Jack Attack (2005), Pixar non introdusse nuove tecniche rispetto a The Incredibles, ma sfruttò in maniera più complessa gli strumenti già sviluppati, come il Goo Muscle Rig e il Core Simulation. La sfida principale fu orchestrare contemporaneamente molte deformazioni, simulazioni e effetti particellari per rappresentare i diversi poteri di Jack-Jack, mantenendo coerenza visiva e reattività della pelle, dei muscoli e dei capelli. Il corto rappresenta quindi un avanzamento nell’applicazione e nella gestione integrata delle tecnologie già esistenti, piuttosto che un’innovazione tecnica pura.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/21/copertina_21&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/21/poster_21&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/21/invz21_img_A_21&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/21/invz21_img_B_21&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/21/invz21_img_C_21&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:22,&#34;PERSONAGGIO&#34;:&#34;Lightning McQueen&#34;,&#34;FILM&#34;:&#34;Cars&#34;,&#34;ANNO&#34;:2006,&#34;INNOVAZIONE&#34;:&#34;Ray Tracing&#34;,&#34;INNOVAZIONE2&#34;:&#34;Ground Locking&#34;,&#34;CATEGORY&#34;:&#34;Modelling/Light&#34;,&#34;CATEGORY2&#34;:&#34;Modelling&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/22/copertina_22&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_22.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:22,&#34;Personaggio/soggetto&#34;:&#34;Lightning McQueen&#34;,&#34;Film/corto&#34;:&#34;Cars&#34;,&#34;Anno&#34;:2006,&#34;Regista/autore&#34;:&#34;John Lasseter&#34;,&#34;Trama&#34;:&#34;The young and ambitious racing champion Lightning McQueen is speeding down the fast track toward success, fame, and everything he has ever wanted—until an unexpected detour on the dusty Route 66 forces him to slow down. His “want it all, want it now” attitude is put to the test when a small, forgotten town shows McQueen what he’s been missing in his high-octane life.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=nkK9BtGgogU&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=UmEsDXKuKBM&#38;list=PLLhVNqe2jAb8N1YBIAt9Iys7O-LmRBD1c&#38;index=4 &#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=4NDYQ2JQbEo&#38;list=PLLhVNqe2jAb8N1YBIAt9Iys7O-LmRBD1c&#38;index=5&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling/Light&#34;,&#34;Nome Innovazione 1&#34;:&#34;Ray Tracing&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;In Cars, Pixar’s visual challenge was tied to rendering reflective materials and realistically animating vehicles along complex routes. To achieve believable surfaces on glossy car bodies and streets illuminated by ambient light, Ray Tracing was used, calculating how light interacts with objects and materials to generate realistic reflections and bounces.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Ray Tracing is a rendering algorithm that traces light rays from the camera to the surfaces in the scene, calculating reflections, refractions, and interactions with different materials in a physically accurate way. In Cars, this allowed for realistic representation of glossy car bodies, paved roads, and the reflective surfaces of surrounding objects.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 2&#34;:&#34;Ground Locking&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;To simplify vehicle animation and ensure they always stayed on the road, the Ground Locking system was introduced. This allowed the cars to automatically follow the road’s trajectory, transitioning from straight to undulating paths without animators having to adjust each frame, ensuring smooth and believable movement.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;Ground Locking is a procedural animation system that automatically aligns a 3D car model to the path defined by the road, adjusting the vehicle’s position and orientation to curves and terrain undulations. This allowed animators to focus on the characters’ performances, while the software ensured that the cars always remained “stuck” to the trajectory, avoiding overlap errors or unnatural movements.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Ray Tracing/Ground Locking&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/22/copertina_22&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/22/poster_22&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/22/invz22_img_A_22&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/22/invz22_img_B_22&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/22/invz22_img_C_22&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:23,&#34;PERSONAGGIO&#34;:&#34;Mater&#34;,&#34;FILM&#34;:&#34;Mater And The Ghostlight&#34;,&#34;ANNO&#34;:2006,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/23/copertina_23&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_23.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:23,&#34;Personaggio/soggetto&#34;:&#34;Mater&#34;,&#34;Film/corto&#34;:&#34;Mater And The Ghostlight&#34;,&#34;Anno&#34;:2006,&#34;Regista/autore&#34;:&#34;John Lasseter&#34;,&#34;Trama&#34;:&#34;Mater is haunted by a mysterious blue light that teaches him not to play pranks on the other cars in Radiator Springs.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=hY2JIhMvcs0&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/23/copertina_23&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/23/poster_23&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/23/invz23_img_A_23&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/23/invz23_img_B_23&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/23/invz23_img_C_23&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:24,&#34;PERSONAGGIO&#34;:&#34;Stu&#34;,&#34;FILM&#34;:&#34;Lifted&#34;,&#34;ANNO&#34;:2006,&#34;INNOVAZIONE&#34;:&#34;Multi-Axes Rig&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/24/copertina_24&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_24.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:24,&#34;Personaggio/soggetto&#34;:&#34;Stu&#34;,&#34;Film/corto&#34;:&#34;Lifted&#34;,&#34;Anno&#34;:2006,&#34;Regista/autore&#34;:&#34;Gary Rydstrom&#34;,&#34;Trama&#34;:&#34;When an overconfident teenage alien takes command of a spaceship, he must attempt to abduct a sleeping farmer under the watchful eye of a strict instructor. But kidnapping humans requires precision and finesse, and after a few missteps it becomes painfully clear why no one disappears every year anymore.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=LVLoc6FrLi0&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Multi-Axes Rig&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Pixar developed for the first time a highly flexible multi-axis rig to handle the complex animations of the alien Stu and the spaceship. This system was used to simultaneously control the character’s body, arms, legs, and the spaceship’s interactive instruments, allowing animators to create comedic and exaggerated movements without animating each element separately. The rig was crucial for making Stu’s interactions with the surrounding environment believable and synchronized, ensuring fluidity and precision in the visual gags.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The Multi-Axis rig integrates controls on multiple levels: each of the character’s limbs, the central body, and the spaceship’s objects are linked to a system of constraints and manipulators that automatically calculate the relationships between the parts. Animators can move a single control, and the rig distributes deformation and movement to the other elements in real time, maintaining anatomical and kinematic consistency. This approach allows the combination of muscle deformations, limb rotations, and interactive object movements without losing creative control, greatly simplifying the management of complex and slapstick actions like Stu’s kidnapping attempts.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/24/copertina_24&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/24/poster_24&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/24/invz24_img_A_24&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/24/invz24_img_B_24&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/24/invz24_img_C_24&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:25,&#34;PERSONAGGIO&#34;:&#34;Food&#34;,&#34;FILM&#34;:&#34;Ratatouille&#34;,&#34;ANNO&#34;:2007,&#34;INNOVAZIONE&#34;:&#34;Subsurface Scattering&#34;,&#34;INNOVAZIONE2&#34;:&#34;Gummi Glow&#34;,&#34;CATEGORY&#34;:&#34;Texture/Materials&#34;,&#34;CATEGORY2&#34;:&#34;Light&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/25/copertina_25&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_25.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:25,&#34;Personaggio/soggetto&#34;:&#34;Food&#34;,&#34;Film/corto&#34;:&#34;Ratatouille&#34;,&#34;Anno&#34;:2007,&#34;Regista/autore&#34;:&#34;Brad Bird&#34;,&#34;Trama&#34;:&#34;A rat named Remy dreams of becoming a great chef, despite his family’s wishes and the obvious problem of being a rat in a profession decidedly hostile to rodents. When fate leads Remy to the sewers of Paris, he finds himself perfectly positioned beneath a restaurant made famous by his culinary hero, Auguste Gusteau. Remy’s passion for cooking soon sets off a frantic and hilarious rat-paced adventure that shakes up Paris’s gastronomic world.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=LrGgU2WXnf8&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=tjYmGqYgVxA&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Texture/Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;Subsurface Scattering&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Subsurface Scattering is used to make food look extremely realistic and appetizing while maintaining a visual style consistent with the animation. It was initially applied to ingredients to simulate light diffusion through fruits, vegetables, cheeses, and other foods, giving them a soft and translucent appearance.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;This technique simulates the behavior of light within semi-transparent materials: part of the light penetrates the object, diffuses internally, and then emerges at a different point, while another part is immediately reflected by the surface. It creates softness and translucency, essential for making ingredients like tomatoes, carrots, or cheeses look realistic, which would otherwise appear flat and artificial.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Light&#34;,&#34;Nome Innovazione 2&#34;:&#34;Gummi Glow&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;Gummi Glow allows to add soft glows and reflections to surfaces, making kitchen scenes and prepared dishes more vivid and luminous, enhancing the perception of freshness and warmth.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;In practice, Gummi Glow applies a subtle glow to surfaces, integrating reflections and light diffusion to enhance the three-dimensionality and shine of objects.&#34;,&#34;Riepilogo innovazioni&#34;:&#34;Subsurface Scattering/Gummi Glow&#34;,&#34;Copertina&#34;:&#34;assets/images/personaggi/25/copertina_25&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/25/poster_25&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/25/invz25_img_A_25&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/25/invz25_img_B_25&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/25/invz25_img_C_25&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:26,&#34;PERSONAGGIO&#34;:&#34;Remy&#34;,&#34;FILM&#34;:&#34;Your Friend the Rat&#34;,&#34;ANNO&#34;:2007,&#34;INNOVAZIONE&#34;:&#34;2D/3D Hybrid Animation&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/26/copertina_26&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_26.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:26,&#34;Personaggio/soggetto&#34;:&#34;Remy&#34;,&#34;Film/corto&#34;:&#34;Your Friend the Rat&#34;,&#34;Anno&#34;:2007,&#34;Regista/autore&#34;:&#34;Jim Capobianco&#34;,&#34;Trama&#34;:&#34;Let’s face it: mice aren’t exactly among the most beloved creatures on Earth. However, perhaps this little story about the history of human–mouse interactions might just change minds. At least, that’s the hope of Remy, the protagonist of Ratatouille, and his reluctant brother Emile, as they guide us through the history of the world from a mouse’s perspective. Why can’t we all just get along?&#34;,&#34;Link 1&#34;:null,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:&#34;2D/3D Hybrid Animation&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The short primarily uses traditional 2D animation, occasionally integrating simple 3D elements to add depth and movement to objects or characters.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/26/copertina_26&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/26/poster_26&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/26/invz26_img_A_26&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/26/invz26_img_B_26&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/26/invz26_img_C_26&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:27,&#34;PERSONAGGIO&#34;:&#34;WALL • E&#34;,&#34;FILM&#34;:&#34;WALL • E&#34;,&#34;ANNO&#34;:2008,&#34;INNOVAZIONE&#34;:&#34;New Camera System&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/27/copertina_27&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_27.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:27,&#34;Personaggio/soggetto&#34;:&#34;WALL • E&#34;,&#34;Film/corto&#34;:&#34;WALL • E&#34;,&#34;Anno&#34;:2008,&#34;Regista/autore&#34;:&#34;Andrew Stanton&#34;,&#34;Trama&#34;:&#34;What if humanity was forced to leave Earth and someone forgot to turn off the last robot? After hundreds of years performing the task it was built for, WALL·E discovers a new purpose in life when he meets a sleek exploration robot named EVE. EVE realizes that WALL·E has inadvertently gotten hold of the key to the planet’s future and rushes into space to report back to the humans. Meanwhile, WALL·E chases EVE across the galaxy, launching one of the most inventive adventures ever brought to the big screen.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=CZ1CATNbXg0&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=G8tlVs4r7zg&#38;t=606s&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;New Camera System&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;This technique was used to achieve a more natural and engaging cinematic language, capable of recreating the shots and movements typical of a real camera. The aim was to make the three-dimensional space feel more realistic and give a sense of “presence” to the movements of the characters and the environment, especially in scenes where WALL·E and EVE interact with detailed objects and settings. The system mimicked the effect of an imperfect Steadicam, introducing slight imperfections and delays in focus changes, as if the real operator were observing the action and reacting late to events on set.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The New Camera System is a virtual camera control engine that simulates the behaviour of a real camera in three-dimensional space. The camera does not rigidly follow characters or points of interest, but introduces lag in movements and focus changes, replicating the natural delayed response of a human operator. This is achieved by combining interpolation algorithms for camera position and orientation with dynamic focus calculations based on the distance from key objects in the scene. The result is a more organic cinematic effect: movements appear natural and slightly imperfect, increasing viewer immersion and conveying the feeling of observing the world through a real camera.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/27/copertina_27&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/27/poster_27&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/27/invz27_img_A_27&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/27/invz27_img_B_27&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/27/invz27_img_C_27&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:28,&#34;PERSONAGGIO&#34;:&#34;BURN • E&#34;,&#34;FILM&#34;:&#34;BURN • E&#34;,&#34;ANNO&#34;:2008,&#34;INNOVAZIONE&#34;:&#34;&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/28/copertina_28&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_28.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:28,&#34;Personaggio/soggetto&#34;:&#34;BURN • E&#34;,&#34;Film/corto&#34;:&#34;BURN • E&#34;,&#34;Anno&#34;:2008,&#34;Regista/autore&#34;:&#34;Angus MacLane&#34;,&#34;Trama&#34;:&#34;How far can a robot go to get its job done? BURN·E is a dedicated and tireless robot who finds himself locked out of his spacecraft. He soon discovers that completing a simple task can turn out to be far more challenging than expected.&#34;,&#34;Link 1&#34;:&#34;Short film: https://www.youtube.com/watch?v=M4JYdi04KGY&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:null,&#34;Nome Innovazione 1&#34;:null,&#34;Paragrafo motivazione innovazione 1&#34;:null,&#34;Info specifiche sul funzionamento 1&#34;:null,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/28/copertina_28&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/28/poster_28&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/28/invz28_img_A_28&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/28/invz28_img_B_28&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/28/invz28_img_C_28&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:29,&#34;PERSONAGGIO&#34;:&#34;Balloons&#34;,&#34;FILM&#34;:&#34;Up&#34;,&#34;ANNO&#34;:2009,&#34;INNOVAZIONE&#34;:&#34;New Simulation System&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/29/copertina_29&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_29.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:29,&#34;Personaggio/soggetto&#34;:&#34;Balloons&#34;,&#34;Film/corto&#34;:&#34;Up&#34;,&#34;Anno&#34;:2009,&#34;Regista/autore&#34;:&#34; Pete Docter, Bob Peterson&#34;,&#34;Trama&#34;:&#34;A 78-year-old grumpy and cantankerous balloon salesman is not your typical hero. When he ties thousands of balloons to his house and soars away to the wilds of South America, he finally fulfills his lifelong dream of adventure. But when Carl discovers an 8-year-old stowaway named Russell, this unlikely pair soon finds themselves on a hilarious adventure in a lost world, full of dangers and surprises.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=ORFWdXl_zJ4&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=hPQuzPm73fo&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/shorts/55taDa37Oqs&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;New Simulation System&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The New Simulation System functions as an advanced physics engine: each balloon is treated as a dynamic object with mass, lift, air resistance, and connection constraints to the house. The software calculates collisions between the balloons themselves and between balloons and the house, ensuring they don’t overlap unnaturally and react realistically to wind or the protagonist’s movements. The algorithm allows thousands of objects to be simulated simultaneously while maintaining stability and visual consistency, providing animators with real-time feedback that makes managing the complex scene easier without manually animating each individual balloon.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;To animate Carl’s house suspended by 10,000 balloons, the New Simulation System was developed—a motion simulator capable of realistically handling collisions and interactions among a very large number of objects. This system allowed animators to coordinate the movements of the balloons with each other and with the house, creating a natural and believable effect that was impossible to achieve with the previous system, which could handle only about 500 balloons at a time.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/29/copertina_29&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/29/poster_29&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/29/invz29_img_A_29&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/29/invz29_img_B_29&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/29/invz29_img_C_29&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:30,&#34;PERSONAGGIO&#34;:&#34;Clothes&#34;,&#34;FILM&#34;:&#34;Toy Story 3&#34;,&#34;ANNO&#34;:2010,&#34;INNOVAZIONE&#34;:&#34;New 3D Cloth System&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/30/copertina_30&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_30.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:30,&#34;Personaggio/soggetto&#34;:&#34;Clothes&#34;,&#34;Film/corto&#34;:&#34;Toy Story 3&#34;,&#34;Anno&#34;:2010,&#34;Regista/autore&#34;:&#34;Lee Unkrich&#34;,&#34;Trama&#34;:&#34;The creators of the beloved Toy Story films reopen the toy box and bring audiences back into the delightful world of our favorite toy characters in Toy Story 3. As Andy prepares to leave for college, Buzz, Woody, and all his loyal toys worry about their uncertain future. Toy Story 3 is a comedic adventure that takes the toys into a room full of unruly children, eager to get their sticky hands on these “new” toys. Chaos ensues as the toys try to stick together, making sure that “no toy gets left behind.”&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=2BlMNH1QTeE&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=zBZ7KfiK1xQ&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=nluPF2j3QDY&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;New 3D Cloth System&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The New 3D Cloth System uses a cloth simulation engine that dynamically calculates how clothing reacts to body movements, gravity, and collisions with other objects or parts of the character’s body. Each garment is treated as a physical object with properties such as mass, friction, and flexibility, allowing for natural deformations and realistic folds. The system is integrated to enable animators and designers to quickly create and test multiple clothing variations.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;For this film, Pixar needed to animate a large number of characters with realistic clothing. To achieve this, the New 3D Cloth System was developed—a system that allowed garments to be designed and simulated quickly and efficiently. The goal was to enable all designers to create detailed outfits without being digital tailoring experts, making it possible to dress dozens of characters in coherent and believable costumes. The system was crucial for managing the complexity of crowd scenes and reducing production time.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/30/copertina_30&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/30/poster_30&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/30/invz30_img_A_30&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/30/invz30_img_B_30&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/30/invz30_img_C_30&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:31,&#34;PERSONAGGIO&#34;:&#34;Ocean&#34;,&#34;FILM&#34;:&#34;Cars 2&#34;,&#34;ANNO&#34;:2011,&#34;INNOVAZIONE&#34;:&#34;Tessendorf Ocean Generator&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/31/copertina_31&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_31.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:31,&#34;Personaggio/soggetto&#34;:&#34;Ocean&#34;,&#34;Film/corto&#34;:&#34;Cars 2&#34;,&#34;Anno&#34;:2011,&#34;Regista/autore&#34;:&#34;John Lasseter, Brad Lewis.&#34;,&#34;Trama&#34;:&#34;Racing star Lightning McQueen and the incomparable tow truck Mater take their friendship on thrilling adventures in Cars 2, traveling overseas to compete in the very first World Grand Prix to determine the fastest car in the world. But the road to the championship is full of potholes, detours, and hilarious surprises—especially when Mater finds himself caught up in an intriguing adventure of his own: international espionage.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=lg5hj2c5Nkk&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=vMgEDpx1GXg&#34;,&#34;Link 3&#34;:&#34;https://www.youtube.com/watch?v=s_3zsRl0yMM&#38;list=PLkVBJymkFErmVjGA_sJvZwr7CFirexCaa&#38;index=10&#34;,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Tessendorf Ocean Generator&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The Tessendorf Ocean Generator is based on physical simulation algorithms that model ocean wave behavior using Fourier transforms to represent the wave spectrum over large surfaces. Each point on the water’s surface calculates wave height, direction, and speed according to physical parameters such as wind, current, and turbulence. The system also incorporates simplified collisions with animated objects (cars, boats, hulls), allowing water surfaces to react realistically to interactions without compromising simulation stability.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;To achieve believable and dynamic rippling waves, the Tessendorf Ocean Generator was used—a system developed to simulate ocean surfaces based on physical models. This tool allowed large bodies of water with realistic waves to be generated quickly, without manual animation, enhancing the realism of the scenes and ensuring consistency with the interactions of cars and boats with the water.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/31/copertina_31&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/31/poster_31&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/31/invz31_img_A_31&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/31/invz31_img_B_31&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/31/invz31_img_C_31&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:32,&#34;PERSONAGGIO&#34;:&#34;Merida&#34;,&#34;FILM&#34;:&#34;Brave&#34;,&#34;ANNO&#34;:2012,&#34;INNOVAZIONE&#34;:&#34;Taz&#34;,&#34;INNOVAZIONE2&#34;:&#34;Presto&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Motion&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/32/copertina_32&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_32.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:32,&#34;Personaggio/soggetto&#34;:&#34;Merida&#34;,&#34;Film/corto&#34;:&#34;Brave&#34;,&#34;Anno&#34;:2012,&#34;Regista/autore&#34;:&#34;Mark Andrews, Brenda Chapman, Steve Purcell&#34;,&#34;Trama&#34;:&#34;Brave introduces a multitude of new characters to audiences, from the fiery teenage princess Merida to the murderous bear Mor’du. When Merida’s mother, the dignified and elegant Queen Elinor, is transformed into a bear, mother and daughter must work together to find a way to reverse the spell, all the while attempting to placate feuding lords and avoid the kingdom’s most renowned bear hunter—King Fergus himself.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=tYg0VgPy6Uk&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=Cecx5HVtUDY&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Taz&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To handle every single strand of Merida's curly hair&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It was powerful enough to handle the 1,500 hand-placed curls on Merida's head. Taz accounted for all the interactions between different strands while making sure that every curl held its shape. The system also changed the effect of gravity on Merida's hair, using a gravity coefficient closer to the one on the moon than the one on Earth. With a lower gravity, the hair could keep its mass but flow and bounce in a natural way.\\nTo give the hair its softness, the lighting team used a mix of subsurface scattering and colored shadows to imitate the complex way curly hair scatters and transmits light.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 2&#34;:&#34;Presto&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;Used here for the first time to animate a feature film, developed from Geppetto&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;It is the proprietary software developed and used in-house by Pixar Animation Studios in the animation of its features and short films. In 2012 it replaced Pixar's older proprietary animation software known commonly as Marionette.&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/32/copertina_32&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/32/poster_32&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/32/invz32_img_A_32&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/32/invz32_img_B_32&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/32/invz32_img_C_32&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:33,&#34;PERSONAGGIO&#34;:&#34;Queen Elinor&#34;,&#34;FILM&#34;:&#34;Brave&#34;,&#34;ANNO&#34;:2012,&#34;INNOVAZIONE&#34;:&#34;Loom Technology&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Materials&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/33/copertina_33&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_33.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:33,&#34;Personaggio/soggetto&#34;:&#34;Queen Elinor&#34;,&#34;Film/corto&#34;:&#34;Brave&#34;,&#34;Anno&#34;:2012,&#34;Regista/autore&#34;:&#34;Mark Andrews, Brenda Chapman, Steve Purcell&#34;,&#34;Trama&#34;:&#34;Brave introduces a multitude of new characters to audiences, from the fiery teenage princess Merida to the murderous bear Mor’du. When Merida’s mother, the dignified and elegant Queen Elinor, is transformed into a bear, mother and daughter must work together to find a way to reverse the spell, all the while attempting to placate feuding lords and avoid the kingdom’s most renowned bear hunter—King Fergus himself.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=tYg0VgPy6Uk&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;Loom Technology&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Shading software used for detailed fabrics for example the ones used for Queen Elinor's dresses&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It weaves every strand of virtual fabric into a shading software giving clothes richer clothes and a more tactile quality&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/33/copertina_33&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/33/poster_33&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/33/invz33_img_A_33&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/33/invz33_img_B_33&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/33/invz33_img_C_33&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:34,&#34;PERSONAGGIO&#34;:&#34;King Fergus&#34;,&#34;FILM&#34;:&#34;Brave&#34;,&#34;ANNO&#34;:2012,&#34;INNOVAZIONE&#34;:&#34;Loom Technology&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Materials&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/34/copertina_34&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_34.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:34,&#34;Personaggio/soggetto&#34;:&#34;King Fergus&#34;,&#34;Film/corto&#34;:&#34;Brave&#34;,&#34;Anno&#34;:2012,&#34;Regista/autore&#34;:&#34;Mark Andrews, Brenda Chapman, Steve Purcell&#34;,&#34;Trama&#34;:&#34;Brave introduces a multitude of new characters to audiences, from the fiery teenage princess Merida to the murderous bear Mor’du. When Merida’s mother, the dignified and elegant Queen Elinor, is transformed into a bear, mother and daughter must work together to find a way to reverse the spell, all the while attempting to placate feuding lords and avoid the kingdom’s most renowned bear hunter—King Fergus himself.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=tYg0VgPy6Uk&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;Loom Technology&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;Shading software used for King Fergus's 16 layers of costume&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It weaves every strand of virtual fabric into a shading software giving clothes richer clothes and a more tactile quality&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/34/copertina_34&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/34/poster_34&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/34/invz34_img_A_34&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/34/invz34_img_B_34&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/34/invz34_img_C_34&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:35,&#34;PERSONAGGIO&#34;:&#34;Setting&#34;,&#34;FILM&#34;:&#34;Monsters University&#34;,&#34;ANNO&#34;:2013,&#34;INNOVAZIONE&#34;:&#34;Global illumination&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Light&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/35/copertina_35&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_35.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:35,&#34;Personaggio/soggetto&#34;:&#34;Setting&#34;,&#34;Film/corto&#34;:&#34;Monsters University&#34;,&#34;Anno&#34;:2013,&#34;Regista/autore&#34;:&#34;Dan Scanlon&#34;,&#34;Trama&#34;:&#34;Set during their formidable college years, Monsters University sees much younger versions of Mike and Sulley. Mike is a little smaller, and even has a retainer, while Sulley is shaggier, thinner and not quite bulked up to the Scarer we know him to be.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=xBzPioph8CI&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Light&#34;,&#34;Nome Innovazione 1&#34;:&#34;Global illumination&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;New lighting system, to focus on the artistic, rather than the engineering, side of lighting, like creating new \\&#34;scare lights\\&#34; for scary monster scenes.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It models the natural distribution of light in a scene, all based on real-world physics&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/35/copertina_35&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/35/poster_35&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/35/invz35_img_A_35&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/35/invz35_img_B_35&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/35/invz35_img_C_35&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:36,&#34;PERSONAGGIO&#34;:&#34;Joy&#34;,&#34;FILM&#34;:&#34;Inside Out&#34;,&#34;ANNO&#34;:2015,&#34;INNOVAZIONE&#34;:&#34;Geolight&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Light / Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/36/copertina_36&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_36.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:36,&#34;Personaggio/soggetto&#34;:&#34;Joy&#34;,&#34;Film/corto&#34;:&#34;Inside Out&#34;,&#34;Anno&#34;:2015,&#34;Regista/autore&#34;:&#34;Pete Docter, Ronnie del Carmen&#34;,&#34;Trama&#34;:&#34;Growing Up Can Be A Bumpy Road and it’s no exception for Riley, who is uprooted from her Midwest life when her father starts a new job in San Francisco. Like all of us, Riley is guided by her emotions – Joy, Fear, Anger, Disgust and Sadness. The emotions live in Headquarters, the control center inside Riley’s mind, where they help advise her through everyday life. As Riley and her emotions struggle to adjust to a new life in San Francisco, turmoil ensues in Headquarters. Although Joy, Riley’s main and most important emotion, tries to keep things positive, the emotions conflict on how best to navigate a new city, house and school.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=yRUAzGQ3nSY&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Light / Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Geolight&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;With this tool Joy's light could travel with her&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;(Geometric Area Lights) Effect introduced by the renderMan team. This tool allowed lighting artists to select a character model and turn it into a mobile light source.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/36/copertina_36&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/36/poster_36&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/36/invz36_img_A_36&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/36/invz36_img_B_36&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/36/invz36_img_C_36&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:37,&#34;PERSONAGGIO&#34;:&#34;Clouds&#34;,&#34;FILM&#34;:&#34;The Good Dinosaur&#34;,&#34;ANNO&#34;:2015,&#34;INNOVAZIONE&#34;:&#34;Cloud Lego Parts&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Background&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/37/copertina_37&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_37.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:37,&#34;Personaggio/soggetto&#34;:&#34;Clouds&#34;,&#34;Film/corto&#34;:&#34;The Good Dinosaur&#34;,&#34;Anno&#34;:2015,&#34;Regista/autore&#34;:&#34;Peter Sohn&#34;,&#34;Trama&#34;:&#34;The Good Dinosaur asks the question: What if the asteroid that forever changed life on Earth missed the planet completely and giant dinosaurs never became extinct? Pixar takes you on an epic journey into the world of dinosaurs where an Apatosaurus named Arlo makes an unlikely human friend. While traveling through a harsh and mysterious landscape, Arlo learns the power of confronting his fears and discovers what he is truly capable of.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=O-RgquKVTPE&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Background&#34;,&#34;Nome Innovazione 1&#34;:&#34;Cloud Lego Parts&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;\\&#34;The Good Dinosaur\\&#34; took place entirely outside, with clouds in almost every scene. So the team decided for the first time to create entirely volumetric clouds that were actually in the scene, making this world that much more immersive.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The clouds team built a huge library of what they called \\&#34;cloud Lego parts.\\&#34; They joined these volumetric forms together to create huge clouds of every type: rain clouds, stratus clouds, and cumulus clouds.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/37/copertina_37&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/37/poster_37&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/37/invz37_img_A_37&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/37/invz37_img_B_37&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/37/invz37_img_C_37&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:38,&#34;PERSONAGGIO&#34;:&#34;Hank&#34;,&#34;FILM&#34;:&#34;Finding Dory&#34;,&#34;ANNO&#34;:2016,&#34;INNOVAZIONE&#34;:&#34;Component Deformation Engine&#34;,&#34;INNOVAZIONE2&#34;:&#34;PhysBAM Volumetric Simulation&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Modeling&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/38/copertina_38&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_38.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:38,&#34;Personaggio/soggetto&#34;:&#34;Hank&#34;,&#34;Film/corto&#34;:&#34;Finding Dory&#34;,&#34;Anno&#34;:2016,&#34;Regista/autore&#34;:&#34;Andrew Stanton, Angus MacLane&#34;,&#34;Trama&#34;:&#34;Forgetful blue tang Dory is living happily in the reef with Marlin and Nemo when Dory suddenly remembers that she has a family out there who may be looking for her, the trio takes off on a life-changing adventure across the ocean to California’s prestigious Marine Life Institute, a rehabilitation center and aquarium. In an effort to find her mom and dad, Dory enlists the help of three of the MLI’s most intriguing residents: Hank, a cantankerous “septopus\\&#34; who frequently gives employees the slip; Bailey, a beluga whale who is convinced his biological sonar skills are on the fritz; and Destiny, a nearsighted whale shark. Deftly navigating the complex inner workings of the MLI, Dory and her friends discover the magic within their flaws, friendships and family.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=JhvrQeY3doI&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=Nn0S2vmSCU0&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Component Deformation Engine&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To capture Hank's extreme flexibility&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It automates movements: when Hank's tentacles move they would move other parts of his body as well&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Modeling&#34;,&#34;Nome Innovazione 2&#34;:&#34;PhysBAM Volumetric Simulation&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;It automates movements: when Hank's tentacles move they would move other parts of his body as well. To give more realism to the movement of each sucker of the tentacles&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;A pre-sim script calculated the snapping and release of the suckers based on distance to a surface and this gave animators controls to easily modify the resulting simulation. The results were then used as an input target pose to the PhysBAM volumentric simulation. A combination of hard and soft constraint forces were used to target the input sucker shapes and to resolve self collision amongst suckers.&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/38/copertina_38&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/38/poster_38&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/38/invz38_img_A_38&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/38/invz38_img_B_38&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/38/invz38_img_C_38&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:39,&#34;PERSONAGGIO&#34;:&#34;Louise Nash&#34;,&#34;FILM&#34;:&#34;Cars 3&#34;,&#34;ANNO&#34;:2017,&#34;INNOVAZIONE&#34;:&#34;Bump Roughness Mapping&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Materials&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/39/copertina_39&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_39.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:39,&#34;Personaggio/soggetto&#34;:&#34;Louise Nash&#34;,&#34;Film/corto&#34;:&#34;Cars 3&#34;,&#34;Anno&#34;:2017,&#34;Regista/autore&#34;:&#34;Brian Fee&#34;,&#34;Trama&#34;:&#34;Blindsided by a new generation of blazing-fast racers, the legendary Lightning McQueen is suddenly pushed out of the sport he loves. To get back in the game, he will need the help of an eager young race technician with her own plan to win, inspiration from the late Fabulous Hudson Hornet, and a few unexpected turns. Proving that #95 isn’t through yet will test the heart of a champion on Piston Cup Racing’s biggest stage!&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=2LeOH9AGJQM&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;Bump Roughness Mapping&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To emphasize the aging details on hero characters, like the older racer Louise Nash&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It converts what looks like bumps up close into surface roughness in farther-away shots&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/39/copertina_39&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/39/poster_39&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/39/invz39_img_A_39&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/39/invz39_img_B_39&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/39/invz39_img_C_39&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:40,&#34;PERSONAGGIO&#34;:&#34;Skeletons&#34;,&#34;FILM&#34;:&#34;Coco&#34;,&#34;ANNO&#34;:2017,&#34;INNOVAZIONE&#34;:&#34;Kingpin&#34;,&#34;INNOVAZIONE2&#34;:&#34;New Continous Collision Detection Program&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Materials&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/40/copertina_40&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_40.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:40,&#34;Personaggio/soggetto&#34;:&#34;Skeletons&#34;,&#34;Film/corto&#34;:&#34;Coco&#34;,&#34;Anno&#34;:2017,&#34;Regista/autore&#34;:&#34;Lee Unkrich&#34;,&#34;Trama&#34;:&#34;A Boy Who Dreams Of Becoming A Great Musician embarks on an extraordinary journey to the magical land of his ancestors. There, the charming trickster Hector becomes an unexpected friend who helps Miguel uncover the mysteries behind his family’s stories and traditions.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=xlnPHQ3TLX8&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Kingpin&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;As a bit of extra texture, the animation team used their proprietary tool Kingpin to add jiggle to the skeletons&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;An automated tool that was utilized to animate a 'jiggle' to the bones to give them a sense of looseness. &#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Materials&#34;,&#34;Nome Innovazione 2&#34;:&#34;New Continous Collision Detection Program&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;To dress complex characters such as skeletons&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;It helped the computer automatically resolve issues like cloth bunching up around a skeleton's hand or snagging on a bony knee.\\nAnimators also digitally wrapped the skeletons' joints with super-stretchy invisible material, so that when the bones separated, the pants would touch that invisible barrier and not fall into the gaps.&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/40/copertina_40&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/40/poster_40&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/40/invz40_img_A_40&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/40/invz40_img_B_40&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/40/invz40_img_C_40&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:41,&#34;PERSONAGGIO&#34;:&#34;Background characters&#34;,&#34;FILM&#34;:&#34;Incredibles 2&#34;,&#34;ANNO&#34;:2018,&#34;INNOVAZIONE&#34;:&#34;Motion Capture &#34;,&#34;INNOVAZIONE2&#34;:&#34;gLux (generalized Lux shading system)&#34;,&#34;CATEGORY&#34;:&#34;Motion / Background&#34;,&#34;CATEGORY2&#34;:&#34;/&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/41/copertina_41&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_41.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:41,&#34;Personaggio/soggetto&#34;:&#34;Background characters&#34;,&#34;Film/corto&#34;:&#34;Incredibles 2&#34;,&#34;Anno&#34;:2018,&#34;Regista/autore&#34;:&#34;Brad Bird&#34;,&#34;Trama&#34;:&#34;Everyone’s favorite family of superheroes is back in “Incredibles 2” – but this time Helen is in the spotlight, leaving Bob at home with Violet and Dash to navigate the day-to-day heroics of “normal” life. It’s a tough transition for everyone, made tougher by the fact that the family is still unaware of baby Jack-Jack’s emerging superpowers. When a new villain hatches a brilliant and dangerous plot, the family and Frozone must find a way to work together again—which is easier said than done, even when they’re all Incredible.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=i5qOzqD9Rms&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion / Background&#34;,&#34;Nome Innovazione 1&#34;:&#34;Motion Capture &#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;For human beings on the background&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;The animators actually started using some motion capture because crowds are hard, as you have to animate, simulate, and render a lot of individual people. It was  used for the filming of background humans. \\nAnimators themselves directed the motion capture shoots focusing on body motion and not on face and hand motion. Faces are the most nuanced part of character performances and for this reason they were animated manually. \\nSince there is complex shot context with multiple characters, fast and scalable character rigs and an algorithm for real time motion retargeting from human actors onto stylized animated characters were created. &#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;/&#34;,&#34;Nome Innovazione 2&#34;:&#34;gLux (generalized Lux shading system)&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;/&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;/&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/41/copertina_41&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/41/poster_41&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/41/invz41_img_A_41&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/41/invz41_img_B_41&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/41/invz41_img_C_41&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:42,&#34;PERSONAGGIO&#34;:&#34;Elastigirl&#34;,&#34;FILM&#34;:&#34;Incredibles 2&#34;,&#34;ANNO&#34;:2018,&#34;INNOVAZIONE&#34;:&#34;3D UV-scaling&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Materials&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/42/copertina_42&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_42.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:42,&#34;Personaggio/soggetto&#34;:&#34;Elastigirl&#34;,&#34;Film/corto&#34;:&#34;Incredibles 2&#34;,&#34;Anno&#34;:2018,&#34;Regista/autore&#34;:&#34;Brad Bird&#34;,&#34;Trama&#34;:&#34;Everyone’s favorite family of superheroes is back in “Incredibles 2” – but this time Helen (voice of Holly Hunter) is in the spotlight, leaving Bob (voice of Craig T. Nelson) at home with Violet (voice of Sarah Vowell) and Dash (voice of Huck Milner) to navigate the day-to-day heroics of “normal” life. It’s a tough transition for everyone, made tougher by the fact that the family is still unaware of baby Jack-Jack’s emerging superpowers. When a new villain hatches a brilliant and dangerous plot, the family and Frozone (voice of Samuel L. Jackson) must find a way to work together again—which is easier said than done, even when they’re all Incredible.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=i5qOzqD9Rms&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Materials&#34;,&#34;Nome Innovazione 1&#34;:&#34;3D UV-scaling&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;The filmmakers wanted their clothing to work better with the extreme movements of characters like Elastigirl.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It manipulates UV coordinates on the clothes to preserve the details of a cloth when stretched or compressed&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/42/copertina_42&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/42/poster_42&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/42/invz42_img_A_42&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/42/invz42_img_B_42&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/42/invz42_img_C_42&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:43,&#34;PERSONAGGIO&#34;:&#34;Antique store toys&#34;,&#34;FILM&#34;:&#34;Toy Story 4&#34;,&#34;ANNO&#34;:2019,&#34;INNOVAZIONE&#34;:&#34;Motion Capture &#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion / Background&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/43/copertina_43&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_43.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:43,&#34;Personaggio/soggetto&#34;:&#34;Antique store toys&#34;,&#34;Film/corto&#34;:&#34;Toy Story 4&#34;,&#34;Anno&#34;:2019,&#34;Regista/autore&#34;:&#34;Josh Cooley&#34;,&#34;Trama&#34;:&#34;Woody has always been confident about his place in the world..and that his priority is taking care of his kid, whether that’s Andy or Bonnie. But when Bonnie adds a reluctant new toy called “Forky” to her room, a road trip adventure alongside old and new friends will show Woody how big the world can be for a toy.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=wmiIUN-7qhE&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion / Background&#34;,&#34;Nome Innovazione 1&#34;:&#34;Motion Capture &#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;There were over 10,000 antiques in this store, and Pixar had to find a way to program each and every one with varying levels of wear and tear.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Animators tackled this challenge by assigning three different ages to the antiques: fairly new, moderately aged, and extremely aged. The computer than gave the items surface details that fit those ages, from micro-scratches on china platters to wear and tear on old rugs.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/43/copertina_43&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/43/poster_43&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/43/invz43_img_A_43&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/43/invz43_img_B_43&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/43/invz43_img_C_43&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:44,&#34;PERSONAGGIO&#34;:&#34;Wilden Lightfoot&#34;,&#34;FILM&#34;:&#34;Onward&#34;,&#34;ANNO&#34;:2020,&#34;INNOVAZIONE&#34;:&#34;Hybrid Simulation-Animation Rig&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/44/copertina_44&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_44.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:44,&#34;Personaggio/soggetto&#34;:&#34;Wilden Lightfoot&#34;,&#34;Film/corto&#34;:&#34;Onward&#34;,&#34;Anno&#34;:2020,&#34;Regista/autore&#34;:&#34;Dan Scanlon&#34;,&#34;Trama&#34;:&#34;Set in a suburban fantasy world, Disney and Pixar’s “Onward” introduces two teenage elf brothers who embark on an extraordinary quest to discover if there is still a little magic left out there. “The story is inspired by my own relationship with my brother and our connection with our dad who passed away when I was about a year old,” says director Dan Scanlon. “He’s always been a mystery to us. A family member sent us a tape recording of him saying just two words: ‘hello’ and ‘goodbye.’ Two words. But to my brother and me—it was magic.\\n\\n“That was the jumping-off point,” continues Scanlon. “We’ve all lost someone, and if we could spend one more day with them—what an exciting opportunity that would be. We knew that if we wanted to tell that story that we’d have to set the movie in a world where you could have that incredible opportunity.”&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=gn5QmllRCn4&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Hybrid Simulation-Animation Rig&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To animate a character made up of only a pair of legs&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;With this rig, animators could manipulate Dad's lower half like they usually would, but the simulation team controlled everything above the belt when needed. The movement of Dad's stuffing was based on a volumetric sim, a simulation for something with volume, while the clothes on top of the stuffing were largely controlled with standard cloth simulation.\\nPixar also improved the interaction between volumetric sims and cloth sims so that if you pushed on Dad's clothing, the stuffing would get squished believably, and vice versa, if you pushed on the stuffing, the clothing would move out of the way.\\nThe hybrid rig improved the relationship between separate simulations, and ultimately, it showed how simulation and animation could join forces to create realistic movement on an unrealistic character.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/44/copertina_44&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/44/poster_44&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/44/invz44_img_A_44&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/44/invz44_img_B_44&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/44/invz44_img_C_44&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:45,&#34;PERSONAGGIO&#34;:&#34;Joe&#34;,&#34;FILM&#34;:&#34;Soul&#34;,&#34;ANNO&#34;:2020,&#34;INNOVAZIONE&#34;:&#34;Finger Contact Rig&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/45/copertina_45&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_45.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:45,&#34;Personaggio/soggetto&#34;:&#34;Joe&#34;,&#34;Film/corto&#34;:&#34;Soul&#34;,&#34;Anno&#34;:2020,&#34;Regista/autore&#34;:&#34;Pete Docter, Kemp Powers&#34;,&#34;Trama&#34;:&#34;“Soul” introduces Joe Gardner (voice of Jamie Foxx) – a middle-school band teacher who has a passion for jazz. “Joe wants more than anything to become a professional jazz pianist,” says director Pete Docter. “So when he’s offered a rare, once-in-a-lifetime opportunity to play with one of the greats, Joe feels he’s reached the top of the ultimate mountain.” \\n\\nBut one small misstep takes him from the streets of New York City to The Great Before – a fantastical place where new souls get their personalities, quirks and interests before they go to Earth. According to Docter, the idea for this unique world was 23 years in the making. “It started with my son—he’s 23 now—but the instant he was born, he already had a personality,” says Docter. “Where did that come from? I thought your personality developed through your interaction with the world. And yet, it was pretty clear that we’re all born with a very unique, specific sense of who we are.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=xOsLIiBStEs&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Finger Contact Rig&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To play instruments, especially the piano&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;When one of Joe's fingers pushed down on a key, the rig would calculate the correct angle for the key to rotate, so it looked like Joe was pushing it. The modeling and rigging teams also gave Joe's hand 292 controls, including variables they'd never used before, even adding a control for each tendon to convey the tension in Joe's hand as he played. This level of hand and wrist control made his performances look passionate and convincing on screen, with a level of realism that pushed the boundaries of human movement in animation.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/45/copertina_45&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/45/poster_45&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/45/invz45_img_A_45&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/45/invz45_img_B_45&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/45/invz45_img_C_45&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:46,&#34;PERSONAGGIO&#34;:&#34;Terry and Jerry&#34;,&#34;FILM&#34;:&#34;Soul&#34;,&#34;ANNO&#34;:2020,&#34;INNOVAZIONE&#34;:&#34;Ground Locking &#34;,&#34;INNOVAZIONE2&#34;:&#34;2D CoDE&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;Motion&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/46/copertina_46&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_46.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:46,&#34;Personaggio/soggetto&#34;:&#34;Terry and Jerry&#34;,&#34;Film/corto&#34;:&#34;Soul&#34;,&#34;Anno&#34;:2020,&#34;Regista/autore&#34;:&#34;Pete Docter, Kemp Powers&#34;,&#34;Trama&#34;:&#34;“Soul” introduces Joe Gardner (voice of Jamie Foxx) – a middle-school band teacher who has a passion for jazz. “Joe wants more than anything to become a professional jazz pianist,” says director Pete Docter. “So when he’s offered a rare, once-in-a-lifetime opportunity to play with one of the greats, Joe feels he’s reached the top of the ultimate mountain.” \\n\\nBut one small misstep takes him from the streets of New York City to The Great Before – a fantastical place where new souls get their personalities, quirks and interests before they go to Earth. According to Docter, the idea for this unique world was 23 years in the making. “It started with my son—he’s 23 now—but the instant he was born, he already had a personality,” says Docter. “Where did that come from? I thought your personality developed through your interaction with the world. And yet, it was pretty clear that we’re all born with a very unique, specific sense of who we are.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=xOsLIiBStEs&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Ground Locking &#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To mantain charcaters \\&#34;glued\\&#34; to the ground, avoiding overlapping errors or unnatural movements&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It's a procedural animation system that automatically aligns the 3D model to a defined path, adapting the character's position and orientation to uneven grounds&#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 2&#34;:&#34;2D CoDE&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;To capture the extreme flexibility of Characters like Terry and Jerry that are made of simple 2D lines&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;It automates movements&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/46/copertina_46&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/46/poster_46&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/46/invz46_img_A_46&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/46/invz46_img_B_46&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/46/invz46_img_C_46&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:47,&#34;PERSONAGGIO&#34;:&#34;Luca&#34;,&#34;FILM&#34;:&#34;Luca&#34;,&#34;ANNO&#34;:2021,&#34;INNOVAZIONE&#34;:&#34;Transformation Rig&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/47/copertina_47&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_47.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:47,&#34;Personaggio/soggetto&#34;:&#34;Luca&#34;,&#34;Film/corto&#34;:&#34;Luca&#34;,&#34;Anno&#34;:2021,&#34;Regista/autore&#34;:&#34;Enrico Casarosa&#34;,&#34;Trama&#34;:&#34;Disney and Pixar’s original feature film “Luca” is a coming-of-age story about one young boy experiencing an unforgettable summer filled with gelato, pasta and endless scooter rides. Luca shares these adventures with his newfound best friend, but all the fun is threatened by a deeply-held secret: they are sea monsters from another world just below the water’s surface.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=mYfJxlgR2jw&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Transformation Rig&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;For the transformation from sea monster to human being&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;With the transformation rig animators could fine-tune the different aspects of the change one by one and see the result right there in front of them. That way, they could perfectly time the transition from the layers of changes in the human skin to the flipping scales and octopus spots in the sea-monster skin.\\nThis was a new way to streamline the whole production process and put more artistic control in the hands of animators.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/47/copertina_47&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/47/poster_47&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/47/invz47_img_A_47&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/47/invz47_img_B_47&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/47/invz47_img_C_47&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:48,&#34;PERSONAGGIO&#34;:&#34;Alberto&#34;,&#34;FILM&#34;:&#34;Luca&#34;,&#34;ANNO&#34;:2021,&#34;INNOVAZIONE&#34;:&#34;Transformation Rig&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/48/copertina_48&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_48.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:48,&#34;Personaggio/soggetto&#34;:&#34;Alberto&#34;,&#34;Film/corto&#34;:&#34;Luca&#34;,&#34;Anno&#34;:2021,&#34;Regista/autore&#34;:&#34;Enrico Casarosa&#34;,&#34;Trama&#34;:&#34;Disney and Pixar’s original feature film “Luca” is a coming-of-age story about one young boy experiencing an unforgettable summer filled with gelato, pasta and endless scooter rides. Luca shares these adventures with his newfound best friend, but all the fun is threatened by a deeply-held secret: they are sea monsters from another world just below the water’s surface.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=mYfJxlgR2jw&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Transformation Rig&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;For the transformation from sea monster to human being&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;with the transformation rig animators could fine-tune the different aspects of the change one by one and see the result right there in front of them. That way, they could perfectly time the transition from the layers of changes in the human skin to the flipping scales and octopus spots in the sea-monster skin.\\nThis was a new way to streamline the whole production process and put more artistic control in the hands of animators.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/48/copertina_48&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/48/poster_48&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/48/invz48_img_A_48&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/48/invz48_img_B_48&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/48/invz48_img_C_48&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:49,&#34;PERSONAGGIO&#34;:&#34;Red Panda Mei&#34;,&#34;FILM&#34;:&#34;Turning Red&#34;,&#34;ANNO&#34;:2022,&#34;INNOVAZIONE&#34;:&#34;Hair Guides&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/49/copertina_49&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_49.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:49,&#34;Personaggio/soggetto&#34;:&#34;Red Panda Mei&#34;,&#34;Film/corto&#34;:&#34;Turning Red&#34;,&#34;Anno&#34;:2022,&#34;Regista/autore&#34;:&#34;Domee Shi&#34;,&#34;Trama&#34;:&#34;Disney and Pixar’s “Turning Red” introduces Mei Lee, a confident, dorky 13-year-old torn between staying her mother’s dutiful daughter and the chaos of adolescence. Her protective, if not slightly overbearing mother, Ming, is never far from her daughter—an unfortunate reality for the teenager. And as if changes to her interests, relationships and body weren’t enough, whenever she gets too excited (which is practically ALWAYS), she “poofs” into a giant red panda!&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=XdKzUbAiswE&#34;,&#34;Link 2&#34;:&#34;https://www.youtube.com/watch?v=5syf6AgtEcY&#34;,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Hair Guides&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;In the feature film Turning Red (2022), the main character is a\\nred panda covered with fur and hair whose grooms contain approximately \\n12 thousands guide hairs and about 2 million render hairs.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;At Pixar, hair and fur grooms are set up in the Presto animation\\nsystem where artists can shape guide hairs as well as view the\\nfull set of render hairs interactively.\\nAnimators start by introducing style guides as an auxiliary representation for hair sculpting\\nthat coarsens guide hairs (Hair Style Guide). They then develop a new method for\\ntransferring deformations from this coarse resolution back onto\\nthe dense hair set (Hair Style Mover). In addition, they propose a user interface for\\nmanaging and selecting hairs layers efficiently (Hair Picker).&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/49/copertina_49&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/49/poster_49&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/49/invz49_img_A_49&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/49/invz49_img_B_49&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/49/invz49_img_C_49&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:50,&#34;PERSONAGGIO&#34;:&#34;Planet of T’Kani Prime&#34;,&#34;FILM&#34;:&#34;Lightyear&#34;,&#34;ANNO&#34;:2022,&#34;INNOVAZIONE&#34;:&#34;Houdini&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/50/copertina_50&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_50.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:50,&#34;Personaggio/soggetto&#34;:&#34;Planet of T’Kani Prime&#34;,&#34;Film/corto&#34;:&#34;Lightyear&#34;,&#34;Anno&#34;:2022,&#34;Regista/autore&#34;:&#34;Angus MacLane&#34;,&#34;Trama&#34;:&#34;“Lightyear” follows the legendary Space Ranger after he’s marooned on a hostile planet 4.2 million light-years from Earth alongside his commander and their crew. \\n\\nAs Buzz tries to find a way back home through space and time, he’s joined by a group of ambitious recruits and his charming robot companion cat, Sox. Complicating matters and threatening the mission is the arrival of Zurg, an imposing presence with an army of ruthless robots and a mysterious agenda.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=BwZs3H_UN3k&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Houdini&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;For a totally alien planet like T’Kani Prime, animators needed something that could create expansive detail but that they could also stylize and shape to fit the look.\\nEarly tests with Houdini heightfields were successful, and they created several pipeline features to enable their use on Lightyear. &#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;Animators use Houdini heightfield tools to generate crater displacement and erosion maps. The network was packaged into a Houdini Digital Asset so they can easily set up a new shot and tweak a few parameters. The variants are added to the model with Houdini’s Solaris. The terrain shader is created and applied in the proprietary shading software, Flow, where they add\\nadditional details, including small craters and small lakes.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/50/copertina_50&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/50/poster_50&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/50/invz50_img_A_50&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/50/invz50_img_B_50&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/50/invz50_img_C_50&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:51,&#34;PERSONAGGIO&#34;:&#34;Ember&#34;,&#34;FILM&#34;:&#34;Elemental&#34;,&#34;ANNO&#34;:2023,&#34;INNOVAZIONE&#34;:&#34;Volumetric Neural Style Transfer&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Motion&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/51/copertina_51&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_51.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:51,&#34;Personaggio/soggetto&#34;:&#34;Ember&#34;,&#34;Film/corto&#34;:&#34;Elemental&#34;,&#34;Anno&#34;:2023,&#34;Regista/autore&#34;:&#34;Peter Sohn&#34;,&#34;Trama&#34;:&#34;Set in Element City, where Fire-, Water-, Earth- and Air-residents live togetherElemental introduces Ember, a tough, quick-witted and fiery young woman, whose friendship with a fun, sappy, go-with-the-flow guy named Wade challenges her beliefs about the world they live in..&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=hXzcyx9V0xw&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Motion&#34;,&#34;Nome Innovazione 1&#34;:&#34;Volumetric Neural Style Transfer&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34; For expressive fire simulation&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;By using more gaseous and languid pyro simulations as input, higher frequency “cusp and curve” shapes could be coherently transferred to the volumes via GPU based optimization process applying recent advances in neural style transfer (NST) to the voxels themselves. A key benefit of this process was the final shape of the fire was decoupled from the underlying simulation. This allowed the simulation to focus on lower frequency\\nmotions and stability, while NST could provide the final touches of shaping, particularly around the silhouette.&#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/51/copertina_51&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/51/poster_51&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/51/invz51_img_A_51&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/51/invz51_img_B_51&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/51/invz51_img_C_51&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:52,&#34;PERSONAGGIO&#34;:&#34;Anxiety&#34;,&#34;FILM&#34;:&#34;Inside Out 2&#34;,&#34;ANNO&#34;:2024,&#34;INNOVAZIONE&#34;:&#34;Curvenet and Profile Mover&#34;,&#34;INNOVAZIONE2&#34;:&#34;Mouth Corner Rig&#34;,&#34;CATEGORY&#34;:&#34;Modelling&#34;,&#34;CATEGORY2&#34;:&#34;Modelling&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/52/copertina_52&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_52.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:52,&#34;Personaggio/soggetto&#34;:&#34;Anxiety&#34;,&#34;Film/corto&#34;:&#34;Inside Out 2&#34;,&#34;Anno&#34;:2024,&#34;Regista/autore&#34;:&#34;Kelsey Mann&#34;,&#34;Trama&#34;:&#34;“Inside Out 2” returns to the mind of newly minted teenager Riley just as headquarters is undergoing a sudden demolition to make room for something entirely unexpected: new Emotions! Joy, Sadness, Anger, Fear and Disgust, who’ve long been running a successful operation by all accounts, aren’t sure how to feel when Anxiety shows up. And it looks like she’s not alone.&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=LEjhY15eCx0&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 1&#34;:&#34;Curvenet and Profile Mover&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To create reusable hand rig&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;These tools were used to create, for the first time at Pixar, a fully articulated Hand Curvenet as a shareable rig.\\nThe result was fully rigged hands for all of our characters, out-of-the-box, without doing any rigging work on the geometry, regardless of shape or topology. &#34;,&#34;Categoria Innovazione (tag) 2&#34;:&#34;Modelling&#34;,&#34;Nome Innovazione 2&#34;:&#34;Mouth Corner Rig&#34;,&#34;Paragrafo Funzionamento generale 2&#34;:&#34;Anxiety is a character that requires specialized mouth rigging configurations for flexible and precise animation control. It requires both rough adjustments and finer details to create a wide array of facial expressions.&#34;,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:&#34;The team devised a mouth corner rig consisting\\nof three layers of controls. The first manipulates the outer silhouette of the mouth\\nand face, allowing for broad adjustments to shape and expression. The second\\nfocuses on moving the mouth corners within the face silhouette, and the third is\\ndedicated to refining the outer silhouette without affecting the teeth placement.&#34;,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/52/copertina_52&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/52/poster_52&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/52/invz52_img_A_52&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/52/invz52_img_B_52&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/52/invz52_img_C_52&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}},{&#34;ID&#34;:53,&#34;PERSONAGGIO&#34;:&#34;Setting&#34;,&#34;FILM&#34;:&#34;Elio&#34;,&#34;ANNO&#34;:2025,&#34;INNOVAZIONE&#34;:&#34;Luna&#34;,&#34;INNOVAZIONE2&#34;:&#34;&#34;,&#34;CATEGORY&#34;:&#34;Light&#34;,&#34;CATEGORY2&#34;:&#34;&#34;,&#34;SRC&#34;:&#34;assets/images/personaggi/53/copertina_53&#34;,&#34;optimizedSrc&#34;:&#34;/images/copertina_53.webp&#34;,&#34;raw&#34;:{&#34;ID&#34;:53,&#34;Personaggio/soggetto&#34;:&#34;Setting&#34;,&#34;Film/corto&#34;:&#34;Elio&#34;,&#34;Anno&#34;:2025,&#34;Regista/autore&#34;:&#34;Adrian Molina, Domee Shi, Madeline Sharafian&#34;,&#34;Trama&#34;:&#34;For centuries, people have called out to the universe looking for answers in Disney and Pixar’s original, all-new feature film “Elio,” the universe calls back! The cosmic misadventure introduces Elio, a space fanatic with an active imagination and a huge alien obsession. “He’s an unusual kid who’s obsessed with getting abducted by aliens,” says director Domee Shi. Elio feels like there’s nothing for him on Earth—he dreams of going to another world where he’s accepted for who he is.”&#34;,&#34;Link 1&#34;:&#34;Trailer: https://www.youtube.com/watch?v=ETVi5_cnnaE&#34;,&#34;Link 2&#34;:null,&#34;Link 3&#34;:null,&#34;Categoria Innovazione (tag) 1&#34;:&#34;Light&#34;,&#34;Nome Innovazione 1&#34;:&#34;Luna&#34;,&#34;Paragrafo motivazione innovazione 1&#34;:&#34;To create a dazzling world it was necessary to have lighting throughout the production process and not just at the final stage.&#34;,&#34;Info specifiche sul funzionamento 1&#34;:&#34;It brought Renderman to interactive workflows all across the pipeline. It allowed the team to use both illumination and camera at the same time to figure out how to guide eyes and tell a story. &#34;,&#34;Categoria Innovazione (tag) 2&#34;:null,&#34;Nome Innovazione 2&#34;:null,&#34;Paragrafo Funzionamento generale 2&#34;:null,&#34;Funzionamento - info maggiori su tecnologie 2&#34;:null,&#34;Riepilogo innovazioni&#34;:null,&#34;Copertina&#34;:&#34;assets/images/personaggi/53/copertina_53&#34;,&#34;Poster&#34;:&#34;assets/images/personaggi/53/poster_53&#34;,&#34;Img01&#34;:&#34;assets/images/personaggi/53/invz53_img_A_53&#34;,&#34;Img02&#34;:&#34;assets/images/personaggi/53/invz53_img_B_53&#34;,&#34;Img03&#34;:&#34;assets/images/personaggi/53/invz53_img_C_53&#34;,&#34;Img04&#34;:null,&#34;Img05&#34;:null,&#34;Img06&#34;:null,&#34;Img07&#34;:null,&#34;Img08&#34;:null,&#34;Img09&#34;:null,&#34;Img10&#34;:null}}]\"></div> <div id=\"image-info\"> <div id=\"image-personaggio\"></div> <div id=\"image-innovazione-box\" class=\"innovation-tag\"></div> <div id=\"image-innovazione-box2\" class=\"innovation-tag\"></div> <div class=\"image-details\"> <div id=\"image-film\"></div> <div id=\"image-anno\"></div> </div> </div> <!-- Filtri per categoria --> <div id=\"category-filters\"> <button id=\"toggle-filters\" class=\"filter-main-button\"> <span>Innovazione</span> <svg class=\"arrow-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M2 4L6 8L10 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path> </svg> </button> <div id=\"filter-options-container\" class=\"filter-options-container hidden\"> <button class=\"filter-button active\" data-category=\"all\">All</button> <button class=\"filter-button\" data-category=\"Motion\">Motion</button> <button class=\"filter-button\" data-category=\"Light\">Light</button> <button class=\"filter-button\" data-category=\"Modelling\">Modelling</button> <button class=\"filter-button\"